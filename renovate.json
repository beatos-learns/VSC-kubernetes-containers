{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "helm-values": { "enabled": false },
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "groupName": "base images"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["src/*/buildCommand"],
      "groupName": "base images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^src/[^/]+/buildCommand$"],
      "matchStrings": [
        "--build-arg [A-Z_]+_IMAGE=(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": ["TRIVY_VERSION: (?<currentValue>[0-9][0-9.]*)"],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": ["SYFT_VERSION: (?<currentValue>[0-9][0-9.]*)"],
      "depNameTemplate": "anchore/syft",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": ["cosign-release: (?<currentValue>v[0-9][0-9.]*)"],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": ["HELM_VERSION: (?<currentValue>v[0-9][0-9.]*)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    }
  ]
}
