# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
ARG APP_UID=10023
ARG APP_GID=10023
ARG VERSION=3.7.10
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
ARG TARGETARCH

# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26@sha256:0d1d3a794be25f809dd2cb3160d8c73276c4056a9f8242a138e908ddeee7b6b6 AS supervisor
ARG TARGETARCH
WORKDIR /src
COPY supervisor/ /src/
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w" -o /out/traefiksupervisor .

# ---------------------------------------------------------------------------
FROM docker.io/library/almalinux:10.2-minimal@sha256:bafd259fb7b0475eed28376ddddea19f209e24efafc9eb21f4e9d5ed9825d2ef AS fetch
ARG TARGETARCH
ARG APP_UID
ARG APP_GID
RUN microdnf install -y tar gzip tzdata && microdnf clean all
RUN case "${TARGETARCH}" in \
      amd64) SUM=01811bb12d44f17280550f425f5e3128d6c325f2665c09e67a651ca535f490ce ;; \
      arm64) SUM=7035c7b31895f5b20c97064ac4c27dacc37e5523a89cb6bf6c16ee0cff9cee83 ;; \
      *) echo "unsupported TARGETARCH ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/traefik.tar.gz "https://github.com/traefik/traefik/releases/download/v3.7.10/traefik_v3.7.10_linux_${TARGETARCH}.tar.gz" \
 && echo "${SUM} /tmp/traefik.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/traefik.tar.gz -C /tmp traefik
RUN install -d -m 1777 /skel/tmp \
 && install -d -m 700 -o ${APP_UID} -g ${APP_GID} /skel/data \
 && install -d -m 755 /skel/etc/traefik/dynamic

# ---------------------------------------------------------------------------
FROM scratch
ARG APP_UID
ARG APP_GID
ARG VERSION
ARG VCS_REF
ARG BUILD_DATE
LABEL org.opencontainers.image.title="traefik" \
      org.opencontainers.image.source="https://github.com/traefik/traefik" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}"
COPY --from=fetch /skel/ /
COPY --from=fetch /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/ssl/certs/ca-certificates.crt
COPY --from=fetch /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=fetch /tmp/traefik /traefik
COPY --from=supervisor /out/traefiksupervisor /traefiksupervisor
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    ZONEINFO=/usr/share/zoneinfo \
    APP_VERSION=${VERSION} \
    APP_REVISION=${VCS_REF} \
    TRAEFIK_ENTRYPOINTS_WEB_ADDRESS=:8080 \
    TRAEFIK_ENTRYPOINTS_WEBSECURE_ADDRESS=:8443 \
    TRAEFIK_ENTRYPOINTS_PING_ADDRESS=127.0.0.1:8082 \
    TRAEFIK_PING=true \
    TRAEFIK_PING_ENTRYPOINT=ping \
    TRAEFIK_ENTRYPOINTS_METRICS_ADDRESS=:9101 \
    TRAEFIK_METRICS_PROMETHEUS=true \
    TRAEFIK_METRICS_PROMETHEUS_ENTRYPOINT=metrics \
    TRAEFIK_PROVIDERS_FILE_DIRECTORY=/etc/traefik/dynamic \
    TRAEFIK_PROVIDERS_FILE_WATCH=true \
    TRAEFIK_LOG_FORMAT=json \
    TRAEFIK_LOG_LEVEL=INFO
USER ${APP_UID}:${APP_GID}
EXPOSE 8080 8443 9090 9101
ENTRYPOINT ["/traefiksupervisor"]
