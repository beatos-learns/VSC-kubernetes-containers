{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "name": { "type": "string" } },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "storageClass": { "type": "string" }
      }
    },
    "nameOverride": { "type": "string" },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "extraObjects": { "type": "array", "items": { "type": "object" } },
    "componentDefaults": { "$ref": "#/definitions/component" },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/component" }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "portSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 15 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "enum": ["TCP", "UDP", "SCTP"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "kind": { "enum": ["Deployment", "StatefulSet"] },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": { "type": "string" },
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uid": { "type": ["integer", "null"], "minimum": 1 },
            "gid": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "main": { "$ref": "#/definitions/portSpec" },
            "admin": { "$ref": "#/definitions/portSpec" },
            "extra": { "type": "array", "items": { "$ref": "#/definitions/portSpec" } }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "secretEnv": { "$ref": "#/definitions/stringMap" },
        "existingSecret": { "type": "string" },
        "secret": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number"] }
        },
        "secretMount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mountPath": { "type": "string" }
          }
        },
        "files": { "$ref": "#/definitions/stringMap" },
        "filesMountPath": { "type": "string" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mountPath": { "type": "string" },
            "subPath": { "type": "string" },
            "size": { "type": "string" },
            "accessModes": { "type": "array", "items": { "type": "string" } },
            "storageClass": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "annotations": { "$ref": "#/definitions/stringMap" },
            "exposeAdmin": { "type": "boolean" }
          }
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string" },
            "annotations": { "$ref": "#/definitions/stringMap" },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host": { "type": "string" },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": { "type": "string" },
                        "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] }
                      }
                    }
                  }
                }
              }
            },
            "tls": { "type": "array", "items": { "type": "object" } }
          }
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": { "$ref": "#/definitions/probe" },
            "liveness": { "$ref": "#/definitions/probe" },
            "readiness": { "$ref": "#/definitions/probe" }
          }
        },
        "resources": { "type": "object" },
        "strategy": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "automountServiceAccountToken": { "type": "boolean" },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" },
        "podLabels": { "$ref": "#/definitions/stringMap" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "command": { "type": "array", "items": { "type": "string" } },
        "args": { "type": "array", "items": { "type": "string" } },
        "initContainers": { "type": "array", "items": { "type": "object" } },
        "extraVolumes": { "type": "array", "items": { "type": "object" } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
