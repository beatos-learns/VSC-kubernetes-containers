+"""Instrumentation of the main listener: route classes, request ids, route metrics, access log."""
+
+from __future__ import annotations
+
+import logging
+import re
+import time
+import uuid
+from collections.abc import Awaitable, Callable, Iterable, Iterator
+from typing import Any
+
+from starlette.routing import Match
+
+from app.ops.logging import log, request_id
+from app.ops.metrics import Counter, Gauge, Histogram, Registry
+
+KNOWN_METHODS = frozenset({"GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"})
+ROUTE_UNKNOWN = "UNKNOWN"
+REQUEST_ID_PATTERN = re.compile(r"^[A-Za-z0-9._-]{1,128}$")
+
+access_logger = logging.getLogger("access")
+
+Scope = dict[str, Any]
+Message = dict[str, Any]
+Receive = Callable[[], Awaitable[Message]]
+Send = Callable[[Message], Awaitable[None]]
+
+
+def outcome_of(status: int) -> str:
+    if 100 <= status < 200:
+        return "INFORMATIONAL"
+    if 200 <= status < 300:
+        return "SUCCESS"
+    if 300 <= status < 400:
+        return "REDIRECTION"
+    if 400 <= status < 500:
+        return "CLIENT_ERROR"
+    if 500 <= status < 600:
+        return "SERVER_ERROR"
+    return "UNKNOWN"
+
+
+class RouteTable:
+    """Maps a request to the template of the route that serves it; anything else is UNKNOWN.
+
+    Included routers are flattened: FastAPI keeps them as lazy wrappers (`original_router`
+    plus an include context with the prefix) instead of copying their routes into the app.
+    """
+
+    def __init__(self, app: Any) -> None:
+        self.routes = list(self._leaves(app.routes, ""))
+
+    @classmethod
+    def _leaves(cls, routes: Iterable[Any], prefix: str) -> Iterator[tuple[Any, str, str]]:
+        for route in routes:
+            included = getattr(route, "original_router", None)
+            if included is not None:
+                context = getattr(route, "include_context", None)
+                extra = getattr(context, "prefix", "") or ""
+                yield from cls._leaves(included.routes, prefix + extra)
+                continue
+            template = getattr(route, "path_format", None)
+            if template is None:
+                nested = getattr(route, "routes", None)
+                if nested:
+                    yield from cls._leaves(nested, prefix + (getattr(route, "path", "") or ""))
+                continue
+            yield route, prefix, prefix + template
+
+    def templates(self) -> list[str]:
+        return sorted({template for _, _, template in self.routes})
+
+    def classify(self, scope: Scope) -> str:
+        path = str(scope.get("path", ""))
+        for route, prefix, template in self.routes:
+            candidate = scope
+            if prefix:
+                if not path.startswith(prefix):
+                    continue
+                candidate = {**scope, "path": path[len(prefix) :]}
+            match, _ = route.matches(candidate)
+            if match is not Match.NONE:
+                return template
+        return ROUTE_UNKNOWN
+
+
+class RequestMetrics:
+    def __init__(self, registry: Registry, templates: list[str]) -> None:
+        self.requests = registry.register(
+            Histogram(
+                "http_server_requests_seconds",
+                "Duration of requests served on the main listener, by route template.",
+                ("method", "uri", "status", "outcome", "exception"),
+            )
+        )
+        self.active = registry.register(
+            Gauge(
+                "http_server_requests_active",
+                "Requests currently in flight on the main listener.",
+                ("method", "uri"),
+            )
+        )
+        self.request_bytes = registry.register(
+            Counter(
+                "http_server_request_bytes_total",
+                "Request body bytes read on the main listener, by route template.",
+                ("uri",),
+            )
+        )
+        self.response_bytes = registry.register(
+            Counter(
+                "http_server_response_bytes_total",
+                "Response body bytes written on the main listener, by route template.",
+                ("uri",),
+            )
+        )
+        for template in [*templates, ROUTE_UNKNOWN]:
+            self.request_bytes.touch(template)
+            self.response_bytes.touch(template)
+
+
+class Instrumentation:
+    """Pure ASGI wrapper around the application; probe traffic never passes through it."""
+
+    def __init__(
+        self, app: Any, routes: RouteTable, metrics: RequestMetrics, access_log: bool
+    ) -> None:
+        self.app = app
+        self.routes = routes
+        self.metrics = metrics
+        self.access_log = access_log
+
+    @staticmethod
+    def _request_id(scope: Scope) -> str:
+        for name, value in scope.get("headers", ()):
+            if name == b"x-request-id":
+                candidate = value.decode("latin-1")
+                if REQUEST_ID_PATTERN.match(candidate):
+                    return candidate
+                break
+        return str(uuid.uuid4())
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        started = time.perf_counter()
+        raw_method = str(scope.get("method", ""))
+        method = raw_method if raw_method in KNOWN_METHODS else "OTHER"
+        uri = self.routes.classify(scope)
+        rid = self._request_id(scope)
+        token = request_id.set(rid)
+        status = 0
+        request_bytes = 0
+        response_bytes = 0
+        exception = "none"
+        self.metrics.active.inc(method, uri)
+
+        async def receive_counted() -> Message:
+            nonlocal request_bytes
+            message = await receive()
+            if message["type"] == "http.request":
+                request_bytes += len(message.get("body", b""))
+            return message
+
+        async def send_counted(message: Message) -> None:
+            nonlocal status, response_bytes
+            if message["type"] == "http.response.start":
+                status = int(message["status"])
+                headers = list(message.get("headers", []))
+                headers.append((b"x-request-id", rid.encode("ascii")))
+                message = {**message, "headers": headers}
+            elif message["type"] == "http.response.body":
+                response_bytes += len(message.get("body", b""))
+            await send(message)
+
+        try:
+            await self.app(scope, receive_counted, send_counted)
+        except Exception as exc:
+            exception = type(exc).__name__
+            if status == 0:
+                status = 500
+            raise
+        finally:
+            elapsed = time.perf_counter() - started
+            self.metrics.active.dec(method, uri)
+            self.metrics.requests.observe(
+                method, uri, str(status), outcome_of(status), exception, value=elapsed
+            )
+            self.metrics.request_bytes.inc(uri, amount=float(request_bytes))
+            self.metrics.response_bytes.inc(uri, amount=float(response_bytes))
+            if self.access_log:
+                log(
+                    access_logger,
+                    "info",
+                    f"{raw_method} {uri} {status}",
+                    **{
+                        "http.request.id": rid,
+                        "http.request.method": raw_method,
+                        "url.path": uri,
+                        "http.response.status_code": status,
+                        "event.duration": int(elapsed * 1e9),
+                        "http.request.bytes": request_bytes,
+                        "http.response.bytes": response_bytes,
+                    },
+                )
+            request_id.reset(token)
