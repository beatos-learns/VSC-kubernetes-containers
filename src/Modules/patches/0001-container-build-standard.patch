@@ -0,0 +1,116 @@
+"""Runtime configuration of the image, read from the environment and validated at startup."""
+
+from __future__ import annotations
+
+import os
+from dataclasses import dataclass
+
+LOG_LEVELS = ("trace", "debug", "info", "warn", "error")
+LOG_FORMATS = ("json", "text")
+
+
+class ConfigError(ValueError):
+    """One clear startup error; the process exits non-zero on it."""
+
+
+def env_str(name: str, default: str) -> str:
+    raw = os.environ.get(name)
+    if raw is None or not raw.strip():
+        return default
+    return raw.strip()
+
+
+def env_number(name: str, default: float, low: float, high: float) -> float:
+    raw = env_str(name, f"{default:g}")
+    try:
+        value = float(raw)
+    except ValueError as exc:
+        raise ConfigError(f"{name}={raw!r} is not a number") from exc
+    if not low <= value <= high:
+        raise ConfigError(f"{name}={raw} is outside [{low:g}, {high:g}]")
+    return value
+
+
+def env_int(name: str, default: int, low: int, high: int) -> int:
+    raw = env_str(name, str(default))
+    try:
+        value = int(raw)
+    except ValueError as exc:
+        raise ConfigError(f"{name}={raw!r} is not an integer") from exc
+    if not low <= value <= high:
+        raise ConfigError(f"{name}={raw} is outside [{low}, {high}]")
+    return value
+
+
+def env_bool(name: str, default: bool) -> bool:
+    raw = env_str(name, "true" if default else "false").lower()
+    if raw in ("true", "1", "yes"):
+        return True
+    if raw in ("false", "0", "no"):
+        return False
+    raise ConfigError(f"{name}={raw!r} is not a boolean")
+
+
+def env_enum(name: str, default: str, allowed: tuple[str, ...]) -> str:
+    value = env_str(name, default).lower()
+    if value not in allowed:
+        raise ConfigError(f"{name}={value!r} is invalid; allowed: {', '.join(allowed)}")
+    return value
+
+
+@dataclass(frozen=True)
+class OpsConfig:
+    port: int
+    admin_port: int
+    bind_addr: str
+    log_level: str
+    log_format: str
+    access_log: bool
+    check_interval: float
+    check_timeout: float
+    stale_factor: float
+    drain_delay: float
+    drain_budget: float
+    app_version: str
+    app_revision: str
+
+    def redacted(self) -> dict[str, object]:
+        return {
+            "PORT": self.port,
+            "ADMIN_PORT": self.admin_port,
+            "BIND_ADDR": self.bind_addr,
+            "LOG_LEVEL": self.log_level,
+            "LOG_FORMAT": self.log_format,
+            "ACCESS_LOG": self.access_log,
+            "HEALTH_CHECK_INTERVAL": self.check_interval,
+            "HEALTH_CHECK_TIMEOUT": self.check_timeout,
+            "HEALTH_STALE_FACTOR": self.stale_factor,
+            "SHUTDOWN_DRAIN_DELAY": self.drain_delay,
+            "SHUTDOWN_TIMEOUT": self.drain_budget,
+        }
+
+
+def load() -> OpsConfig:
+    cfg = OpsConfig(
+        port=env_int("PORT", 8080, 1, 65535),
+        admin_port=env_int("ADMIN_PORT", 9090, 1, 65535),
+        bind_addr=env_str("BIND_ADDR", "0.0.0.0"),
+        log_level=env_enum("LOG_LEVEL", "info", LOG_LEVELS),
+        log_format=env_enum("LOG_FORMAT", "json", LOG_FORMATS),
+        access_log=env_bool("ACCESS_LOG", False),
+        check_interval=env_number("HEALTH_CHECK_INTERVAL", 5, 1, 3600),
+        check_timeout=env_number("HEALTH_CHECK_TIMEOUT", 2, 0.1, 3600),
+        stale_factor=env_number("HEALTH_STALE_FACTOR", 3, 1, 100),
+        drain_delay=env_number("SHUTDOWN_DRAIN_DELAY", 3, 0, 600),
+        drain_budget=env_number("SHUTDOWN_TIMEOUT", 10, 1, 3600),
+        app_version=env_str("APP_VERSION", "dev"),
+        app_revision=env_str("APP_REVISION", "unknown"),
+    )
+    if cfg.check_timeout >= cfg.check_interval:
+        raise ConfigError(
+            f"HEALTH_CHECK_TIMEOUT ({cfg.check_timeout:g}s) must be smaller than "
+            f"HEALTH_CHECK_INTERVAL ({cfg.check_interval:g}s)"
+        )
+    if cfg.port == cfg.admin_port:
+        raise ConfigError("PORT and ADMIN_PORT must differ")
+    return cfg
diff --git a/app/ops/health.py b/app/ops/health.py
new file mode 100644
index 0000000..f91e0ff
--- /dev/null
+++ b/app/ops/health.py
@@ -0,0 +1,244 @@
+"""Cached health checker: one loop owns the real checks, the probes read the last snapshot."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import math
+import time
+from collections.abc import Callable, Iterable
+from concurrent.futures import Future, ThreadPoolExecutor
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from typing import Any
+
+from app.ops.config import OpsConfig
+from app.ops.logging import log
+from app.ops.metrics import CallbackFamily, Labels, Registry
+
+logger = logging.getLogger("app.ops.health")
+
+
+@dataclass(frozen=True)
+class CheckResult:
+    ok: bool
+    detail: str
+    duration: float
+    last_success: float
+
+
+@dataclass(frozen=True)
+class Snapshot:
+    results: dict[str, CheckResult]
+    taken_at: float
+    taken_wall: float
+
+
+@dataclass(frozen=True)
+class Check:
+    name: str
+    run: Callable[[], None]
+
+
+class HealthState:
+    """The probe view: an immutable snapshot behind one reference plus two latches."""
+
+    def __init__(self, cfg: OpsConfig) -> None:
+        self.cfg = cfg
+        self.snapshot: Snapshot | None = None
+        self.started = False
+        self.draining = False
+        self.cycles = 0
+
+    def age(self) -> float:
+        snapshot = self.snapshot
+        if snapshot is None:
+            return math.inf
+        return time.monotonic() - snapshot.taken_at
+
+    def fresh(self) -> bool:
+        return self.age() <= self.cfg.stale_factor * self.cfg.check_interval
+
+    def all_ok(self) -> bool:
+        snapshot = self.snapshot
+        return snapshot is not None and all(result.ok for result in snapshot.results.values())
+
+    def ready(self) -> bool:
+        return self.fresh() and self.all_ok() and not self.draining
+
+    def verbose(self, ok: bool) -> dict[str, Any]:
+        snapshot = self.snapshot
+        checks = {}
+        taken = None
+        if snapshot is not None:
+            taken = datetime.fromtimestamp(snapshot.taken_wall, UTC).isoformat()
+            checks = {
+                name: {
+                    "ok": result.ok,
+                    "detail": result.detail,
+                    "durationSeconds": round(result.duration, 6),
+                    "lastSuccess": (
+                        datetime.fromtimestamp(result.last_success, UTC).isoformat()
+                        if result.last_success
+                        else None
+                    ),
+                }
+                for name, result in snapshot.results.items()
+            }
+        return {
+            "status": "ok" if ok else "unavailable",
+            "started": self.started,
+            "draining": self.draining,
+            "checks": checks,
+            "takenAt": taken,
+        }
+
+    def register_metrics(self, registry: Registry) -> None:
+        def per_check(
+            field: Callable[[CheckResult], float],
+        ) -> Callable[[], Iterable[tuple[Labels, float]]]:
+            def collect() -> Iterable[tuple[Labels, float]]:
+                snapshot = self.snapshot
+                if snapshot is None:
+                    return []
+                return [((name,), field(result)) for name, result in snapshot.results.items()]
+
+            return collect
+
+        registry.register(
+            CallbackFamily(
+                "gauge",
+                "health_check_up",
+                "1 when the check passed in the last checker cycle.",
+                ("check",),
+                per_check(lambda result: 1.0 if result.ok else 0.0),
+            )
+        )
+        registry.register(
+            CallbackFamily(
+                "gauge",
+                "health_check_duration_seconds",
+                "Duration of the last run of the check.",
+                ("check",),
+                per_check(lambda result: result.duration),
+            )
+        )
+        registry.register(
+            CallbackFamily(
+                "gauge",
+                "health_check_last_success_timestamp_seconds",
+                "Unix time of the last pass of the check; 0 until it passed once.",
+                ("check",),
+                per_check(lambda result: result.last_success),
+            )
+        )
+        registry.register(
+            CallbackFamily(
+                "gauge",
+                "health_snapshot_age_seconds",
+                "Age of the cached health snapshot; staleness flips liveness.",
+                (),
+                lambda: [((), 0.0 if self.snapshot is None else self.age())],
+            )
+        )
+        registry.register(
+            CallbackFamily(
+                "counter",
+                "health_checker_cycles_total",
+                "Completed health checker cycles.",
+                (),
+                lambda: [((), float(self.cycles))],
+            )
+        )
+        registry.register(
+            CallbackFamily(
+                "gauge",
+                "health_draining",
+                "1 once the shutdown drain latch is set (readiness 503).",
+                (),
+                lambda: [((), 1.0 if self.draining else 0.0)],
+            )
+        )
+
+
+class Checker:
+    """Runs every registered check concurrently in its own threads, each bounded by the timeout."""
+
+    def __init__(self, cfg: OpsConfig, state: HealthState, checks: list[Check]) -> None:
+        self.cfg = cfg
+        self.state = state
+        self.checks = checks
+        self.in_flight: set[str] = set()
+        self.last_ready: bool | None = None
+        self.executor = ThreadPoolExecutor(
+            max_workers=max(1, len(checks)), thread_name_prefix="health-check"
+        )
+
+    def _finished(self, name: str, future: Future[Any]) -> None:
+        self.in_flight.discard(name)
+        if not future.cancelled():
+            future.exception()
+
+    async def run_one(self, check: Check, previous: CheckResult | None) -> CheckResult:
+        last_success = previous.last_success if previous is not None else 0.0
+        if check.name in self.in_flight:
+            return CheckResult(False, "previous run still in flight", 0.0, last_success)
+        started = time.monotonic()
+        self.in_flight.add(check.name)
+        future = asyncio.get_running_loop().run_in_executor(self.executor, check.run)
+        future.add_done_callback(lambda done: self._finished(check.name, done))
+        try:
+            await asyncio.wait_for(asyncio.shield(future), timeout=self.cfg.check_timeout)
+        except TimeoutError as exc:
+            duration = time.monotonic() - started
+            if duration >= self.cfg.check_timeout:
+                detail = f"timed out after {self.cfg.check_timeout:g}s"
+            else:
+                detail = f"{type(exc).__name__}: {exc}"
+            return CheckResult(False, detail[:500], duration, last_success)
+        except Exception as exc:
+            duration = time.monotonic() - started
+            detail = f"{type(exc).__name__}: {exc}"
+            return CheckResult(False, detail[:500], duration, last_success)
+        return CheckResult(True, "ok", time.monotonic() - started, time.time())
+
+    async def cycle(self) -> None:
+        snapshot = self.state.snapshot
+        previous = snapshot.results if snapshot is not None else {}
+        outcomes = await asyncio.gather(
+            *(self.run_one(check, previous.get(check.name)) for check in self.checks)
+        )
+        results = {check.name: result for check, result in zip(self.checks, outcomes, strict=True)}
+        self.state.snapshot = Snapshot(results, time.monotonic(), time.time())
+        self.state.cycles += 1
+        if not self.state.started and all(result.ok for result in results.values()):
+            self.state.started = True
+            log(logger, "info", "startup complete: first fully successful health cycle")
+        for name, result in results.items():
+            before = previous.get(name)
+            if before is not None and before.ok != result.ok:
+                transition = f"{before.ok} -> {result.ok} ({result.detail})"
+                log(
+                    logger,
+                    "info",
+                    f"health check '{name}' transitioned {transition}",
+                    **{"health.check": name, "health.up": result.ok},
+                )
+        ready = self.state.ready()
+        if self.last_ready is not None and ready != self.last_ready:
+            failing = sorted(name for name, result in results.items() if not result.ok)
+            log(
+                logger,
+                "info",
+                f"readiness {self.last_ready} -> {ready} (failing checks: {failing})",
+            )
+        self.last_ready = ready
+
+    async def loop(self) -> None:
+        while True:
+            begin = time.monotonic()
+            try:
+                await self.cycle()
+            except Exception:
+                logger.exception("health cycle failed")
+            await asyncio.sleep(max(0.0, self.cfg.check_interval - (time.monotonic() - begin)))
