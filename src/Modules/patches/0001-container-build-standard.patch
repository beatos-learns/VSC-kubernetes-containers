+"""Entry point of the image: the service itself, or the exec-style probe command."""
+
+import sys
+
+
+def _main() -> int:
+    argv = sys.argv[1:]
+    if argv and argv[0] == "healthcheck":
+        from app.ops.probe import main as probe_main
+
+        return probe_main(argv[1:])
+    if argv:
+        print(
+            f"unknown arguments {argv!r}; usage: module-service [healthcheck --endpoint=<name>]",
+            file=sys.stderr,
+        )
+        return 2
+    from app.ops.server import main as server_main
+
+    return server_main()
+
+
+if __name__ == "__main__":
+    sys.exit(_main())
