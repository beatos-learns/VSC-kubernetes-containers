@@ -0,0 +1,121 @@
+"""ECS-shaped JSON logging on stdout (flat dotted keys, one object per line), or a text form."""
+
+from __future__ import annotations
+
+import json
+import logging
+import sys
+import traceback
+from contextvars import ContextVar
+from datetime import UTC, datetime
+from typing import Any
+
+SERVICE_NAME = "module-service"
+ECS_VERSION = "8.11"
+TRACE = 5
+LEVEL_NUMBERS = {
+    "trace": TRACE,
+    "debug": logging.DEBUG,
+    "info": logging.INFO,
+    "warn": logging.WARNING,
+    "error": logging.ERROR,
+}
+
+request_id: ContextVar[str | None] = ContextVar("request_id", default=None)
+
+
+def level_name(levelno: int) -> str:
+    if levelno >= logging.ERROR:
+        return "error"
+    if levelno >= logging.WARNING:
+        return "warn"
+    if levelno >= logging.INFO:
+        return "info"
+    if levelno >= logging.DEBUG:
+        return "debug"
+    return "trace"
+
+
+def _timestamp(record: logging.LogRecord) -> str:
+    moment = datetime.fromtimestamp(record.created, UTC)
+    return moment.isoformat(timespec="microseconds").replace("+00:00", "Z")
+
+
+class _EcsFormatter(logging.Formatter):
+    def __init__(self, version: str) -> None:
+        super().__init__()
+        self.version = version
+
+    def fields(self, record: logging.LogRecord) -> dict[str, Any]:
+        entry: dict[str, Any] = {
+            "@timestamp": _timestamp(record),
+            "log.level": level_name(record.levelno),
+            "log.logger": record.name,
+            "message": record.getMessage(),
+            "ecs.version": ECS_VERSION,
+            "service.name": SERVICE_NAME,
+            "service.version": self.version,
+            "process.pid": record.process,
+            "process.thread.name": record.threadName,
+        }
+        extra = getattr(record, "ecs", None)
+        if isinstance(extra, dict):
+            entry.update(extra)
+        rid = request_id.get()
+        if rid is not None:
+            entry.setdefault("http.request.id", rid)
+        if record.exc_info and record.exc_info[0] is not None:
+            entry["error.type"] = record.exc_info[0].__name__
+            entry["error.message"] = str(record.exc_info[1])
+            entry["error.stack_trace"] = "".join(traceback.format_exception(*record.exc_info))
+        return entry
+
+
+class JsonFormatter(_EcsFormatter):
+    def format(self, record: logging.LogRecord) -> str:
+        return json.dumps(self.fields(record), default=str, separators=(",", ":"))
+
+
+class TextFormatter(_EcsFormatter):
+    FIXED = frozenset(
+        {
+            "@timestamp",
+            "log.level",
+            "log.logger",
+            "message",
+            "ecs.version",
+            "service.name",
+            "service.version",
+            "process.pid",
+            "process.thread.name",
+            "error.stack_trace",
+        }
+    )
+
+    def format(self, record: logging.LogRecord) -> str:
+        entry = self.fields(record)
+        level = str(entry["log.level"]).upper()
+        origin = f"{SERVICE_NAME}[{entry['log.logger']}]"
+        line = f"{entry['@timestamp']} {level:5} {origin}: {entry['message']}"
+        for key in sorted(entry):
+            if key not in self.FIXED:
+                line += f" {key}={entry[key]}"
+        if "error.stack_trace" in entry:
+            line += "\n" + str(entry["error.stack_trace"]).rstrip()
+        return line
+
+
+def configure(level: str, fmt: str, version: str) -> None:
+    logging.addLevelName(TRACE, "TRACE")
+    root = logging.getLogger()
+    root.handlers.clear()
+    handler = logging.StreamHandler(sys.stdout)
+    handler.setFormatter(JsonFormatter(version) if fmt == "json" else TextFormatter(version))
+    root.addHandler(handler)
+    root.setLevel(LEVEL_NUMBERS[level])
+    logging.getLogger("uvicorn.error").setLevel(max(LEVEL_NUMBERS[level], logging.WARNING))
+    logging.getLogger("uvicorn.access").disabled = True
+
+
+def log(logger: logging.Logger, level: str, message: str, **fields: Any) -> None:
+    logger.log(LEVEL_NUMBERS[level], message, extra={"ecs": fields})
