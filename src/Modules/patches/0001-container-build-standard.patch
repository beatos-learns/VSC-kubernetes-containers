@@ -0,0 +1,68 @@
+"""The admin listener: probe endpoints over the cached snapshot, and the OpenMetrics exposition."""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Awaitable, Callable
+from typing import Any
+from urllib.parse import parse_qs
+
+from app.ops.health import HealthState
+from app.ops.metrics import CONTENT_TYPE, Registry
+
+Scope = dict[str, Any]
+Message = dict[str, Any]
+Receive = Callable[[], Awaitable[Message]]
+Send = Callable[[Message], Awaitable[None]]
+
+TEXT = "text/plain; charset=utf-8"
+JSON = "application/json"
+
+
+class AdminApp:
+    def __init__(self, state: HealthState, registry: Registry) -> None:
+        self.state = state
+        self.registry = registry
+        self.probes: dict[str, Callable[[], bool]] = {
+            "/startupz": lambda: self.state.started,
+            "/livez": self.state.fresh,
+            "/readyz": self.state.ready,
+        }
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            return
+        method = str(scope.get("method", ""))
+        path = str(scope.get("path", ""))
+        if method not in ("GET", "HEAD"):
+            await self._respond(send, method, 405, TEXT, b"method not allowed")
+            return
+        if path == "/metrics":
+            await self._respond(
+                send, method, 200, CONTENT_TYPE, self.registry.render().encode("utf-8")
+            )
+            return
+        probe = self.probes.get(path)
+        if probe is None:
+            await self._respond(send, method, 404, TEXT, b"not found")
+            return
+        ok = probe()
+        status = 200 if ok else 503
+        query = parse_qs(scope.get("query_string", b"").decode("latin-1"))
+        if query.get("verbose", [""])[0] == "1":
+            body = json.dumps(self.state.verbose(ok)).encode("utf-8")
+            await self._respond(send, method, status, JSON, body)
+            return
+        await self._respond(send, method, status, TEXT, b"ok" if ok else b"unavailable")
+
+    @staticmethod
+    async def _respond(
+        send: Send, method: str, status: int, content_type: str, body: bytes
+    ) -> None:
+        headers = [
+            (b"content-type", content_type.encode("ascii")),
+            (b"content-length", str(len(body)).encode("ascii")),
+            (b"cache-control", b"no-store"),
+        ]
+        await send({"type": "http.response.start", "status": status, "headers": headers})
+        await send({"type": "http.response.body", "body": b"" if method == "HEAD" else body})
