+"""Process entry: configuration, logging, both listeners, the checker and the drain sequence."""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+import os
+import signal
+import sys
+import time
+from collections.abc import Iterable
+from typing import Any
+
+import anyio._backends._asyncio  # noqa: F401
+import sqlalchemy.dialects.mysql.pymysql  # noqa: F401
+import uvicorn.lifespan.off  # noqa: F401
+import uvicorn.lifespan.on  # noqa: F401
+import uvloop
+from pydantic import ValidationError
+from sqlalchemy import event, text
+from sqlalchemy.engine import Engine
+from uvicorn import Config, Server
+from uvicorn.protocols.http.httptools_impl import HttpToolsProtocol
+
+from app.ops import config as ops_config
+from app.ops.admin import AdminApp
+from app.ops.health import Check, Checker, HealthState
+from app.ops.http import Instrumentation, RequestMetrics, RouteTable
+from app.ops.logging import SERVICE_NAME, log
+from app.ops.logging import configure as configure_logging
+from app.ops.metrics import (
+    CallbackFamily,
+    Counter,
+    Gauge,
+    Histogram,
+    Labels,
+    Registry,
+    register_process_families,
+)
+
+logger = logging.getLogger("app.ops.server")
+STATEMENT_OPERATIONS = ("select", "insert", "update", "delete")
+
+
+def fatal(message: str) -> int:
+    print(f"fatal configuration error: {message}", file=sys.stderr, flush=True)
+    return 1
+
+
+def build_server(app: Any, host: str, port: int, lifespan: str, graceful: float | None) -> Server:
+    config = Config(
+        app,
+        host=host,
+        port=port,
+        http=HttpToolsProtocol,
+        ws=None,
+        lifespan=lifespan,
+        log_config=None,
+        access_log=False,
+        server_header=False,
+        timeout_graceful_shutdown=graceful,
+    )
+    config.load()
+    server = Server(config)
+    server.lifespan = config.lifespan_class(config)
+    return server
+
+
+def database_checks(engine: Engine) -> list[Check]:
+    def connectivity() -> None:
+        with engine.connect() as connection:
+            connection.execute(text("SELECT 1"))
+
+    def schema() -> None:
+        with engine.connect() as connection:
+            connection.execute(text("SELECT 1 FROM modules LIMIT 1"))
+
+    return [Check("database", connectivity), Check("schema", schema)]
+
+
+def register_database_metrics(registry: Registry, engine: Engine) -> None:
+    statements = registry.register(
+        Histogram(
+            "db_client_statements_seconds",
+            "Duration of SQL statements executed against the database, by operation.",
+            ("operation",),
+        )
+    )
+    errors = registry.register(
+        Counter(
+            "db_client_statement_errors_total",
+            "SQL statements that raised an error, by operation.",
+            ("operation",),
+        )
+    )
+    for operation in [*STATEMENT_OPERATIONS, "other"]:
+        errors.touch(operation)
+
+    def operation_of(statement: str) -> str:
+        head = statement.lstrip().split(None, 1)[0].lower() if statement.strip() else ""
+        return head if head in STATEMENT_OPERATIONS else "other"
+
+    @event.listens_for(engine, "before_cursor_execute")
+    def before(
+        conn: Any, cursor: Any, statement: str, parameters: Any, context: Any, executemany: bool
+    ) -> None:
+        conn.info["statement_started"] = time.perf_counter()
+
+    @event.listens_for(engine, "after_cursor_execute")
+    def after(
+        conn: Any, cursor: Any, statement: str, parameters: Any, context: Any, executemany: bool
+    ) -> None:
+        started = conn.info.pop("statement_started", None)
+        if started is not None:
+            statements.observe(operation_of(statement), value=time.perf_counter() - started)
+
+    @event.listens_for(engine, "handle_error")
+    def failed(exception_context: Any) -> None:
+        statement = exception_context.statement or ""
+        errors.inc(operation_of(statement))
+        connection = exception_context.connection
+        if connection is not None:
+            started = connection.info.pop("statement_started", None)
+            if started is not None:
+                statements.observe(operation_of(statement), value=time.perf_counter() - started)
+
+    def pool_state() -> Iterable[tuple[Labels, float]]:
+        pool = engine.pool
+        checked_in = getattr(pool, "checkedin", lambda: 0)()
+        checked_out = getattr(pool, "checkedout", lambda: 0)()
+        overflow = max(0, getattr(pool, "overflow", lambda: 0)())
+        return [
+            (("checked_out",), float(checked_out)),
+            (("idle",), float(checked_in)),
+            (("overflow",), float(overflow)),
+        ]
+
+    registry.register(
+        CallbackFamily(
+            "gauge",
+            "db_pool_connections",
+            "Connections of the SQLAlchemy pool by state.",
+            ("state",),
+            pool_state,
+        )
+    )
+    registry.register(
+        CallbackFamily(
+            "gauge",
+            "db_pool_size",
+            "Configured size of the SQLAlchemy connection pool.",
+            (),
+            lambda: [((), float(getattr(engine.pool, "size", lambda: 0)()))],
+        )
+    )
+
+
+def main() -> int:
+    try:
+        cfg = ops_config.load()
+    except ops_config.ConfigError as exc:
+        return fatal(str(exc))
+    configure_logging(cfg.log_level, cfg.log_format, cfg.app_version)
+    try:
+        from app.config import get_settings
+
+        settings = get_settings()
+    except ValidationError as exc:
+        details = "; ".join(
+            f"{'.'.join(str(part) for part in error['loc']) or 'settings'}: {error['msg']}"
+            for error in exc.errors()
+        )
+        return fatal(details)
+    from app.database import engine
+    from app.main import app as fastapi_app
+
+    redacted = {
+        **cfg.redacted(),
+        "DATABASE_URL": engine.url.render_as_string(hide_password=True),
+        "MYSQL_SSL_MODE": settings.mysql_ssl_mode.value,
+        "MYSQL_SSL_CA": str(settings.mysql_ssl_ca) if settings.mysql_ssl_ca else "",
+        "DB_CONNECT_TIMEOUT": settings.db_connect_timeout,
+        "DB_POOL_SIZE": settings.db_pool_size,
+        "DB_POOL_MAX_OVERFLOW": settings.db_pool_max_overflow,
+        "DB_POOL_RECYCLE": settings.db_pool_recycle,
+    }
+    return asyncio.run(
+        serve(cfg, redacted, engine, fastapi_app), loop_factory=uvloop.new_event_loop
+    )
+
+
+async def serve(
+    cfg: ops_config.OpsConfig, redacted: dict[str, Any], engine: Engine, fastapi_app: Any
+) -> int:
+    registry = Registry()
+    registry.register(
+        Gauge("build_info", "The running artifact; always 1.", ("version", "revision"))
+    ).set(cfg.app_version, cfg.app_revision, value=1.0)
+    state = HealthState(cfg)
+    state.register_metrics(registry)
+    routes = RouteTable(fastapi_app)
+    request_metrics = RequestMetrics(registry, routes.templates())
+    register_database_metrics(registry, engine)
+    register_process_families(registry)
+
+    admin_server = build_server(
+        AdminApp(state, registry), cfg.bind_addr, cfg.admin_port, "off", 1.0
+    )
+    main_server = build_server(
+        Instrumentation(fastapi_app, routes, request_metrics, cfg.access_log),
+        cfg.bind_addr,
+        cfg.port,
+        "on",
+        None,
+    )
+    registry.register(
+        CallbackFamily(
+            "gauge",
+            "http_server_connections_active",
+            "Open TCP connections per listener.",
+            ("listener",),
+            lambda: [
+                (("main",), float(len(main_server.server_state.connections))),
+                (("admin",), float(len(admin_server.server_state.connections))),
+            ],
+        )
+    )
+
+    await admin_server.startup()
+    checker = Checker(cfg, state, database_checks(engine))
+    checker_task = asyncio.create_task(checker.loop(), name="health-checker")
+    await main_server.startup()
+    config_line = " ".join(f"{key}={value}" for key, value in redacted.items())
+    log(
+        logger,
+        "info",
+        f"{SERVICE_NAME} listening: version={cfg.app_version} revision={cfg.app_revision} "
+        f"routes={routes.templates()} config[{config_line}]",
+        **{"service.revision": cfg.app_revision, "process.pid": os.getpid()},
+    )
+
+    stop = asyncio.Event()
+    received: list[str] = []
+
+    def on_signal(name: str) -> None:
+        if received:
+            log(logger, "info", f"received {name} while draining: ignored")
+            return
+        received.append(name)
+        stop.set()
+
+    loop = asyncio.get_running_loop()
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        loop.add_signal_handler(sig, on_signal, sig.name)
+    main_task = asyncio.create_task(main_server.main_loop(), name="main-listener")
+    admin_task = asyncio.create_task(admin_server.main_loop(), name="admin-listener")
+
+    await stop.wait()
+    state.draining = True
+    log(
+        logger,
+        "info",
+        f"received {received[0]}: draining (readiness now 503, drain delay {cfg.drain_delay:g}s)",
+    )
+    await asyncio.sleep(cfg.drain_delay)
+    begin = time.monotonic()
+    main_server.should_exit = True
+    await main_task
+    drained = True
+    try:
+        await asyncio.wait_for(main_server.shutdown(), timeout=cfg.drain_budget)
+    except TimeoutError:
+        drained = False
+        abandoned = len(main_server.server_state.connections)
+        log(
+            logger,
+            "error",
+            f"drain budget of {cfg.drain_budget:g}s exhausted: "
+            f"{abandoned} connection(s) still open, closing them",
+        )
+        for connection in list(main_server.server_state.connections):
+            connection.transport.close()
+    checker_task.cancel()
+    with contextlib.suppress(asyncio.CancelledError):
+        await checker_task
+    admin_server.should_exit = True
+    await admin_task
+    await admin_server.shutdown()
+    engine.dispose()
+    elapsed = time.monotonic() - begin
+    if not drained:
+        return 1
+    log(logger, "info", f"graceful shutdown complete in {elapsed:.3f}s")
+    return 0
