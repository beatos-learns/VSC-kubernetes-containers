+++ b/app/ops/metrics.py
@@ -0,0 +1,299 @@
+"""A small OpenMetrics registry: counters, gauges, histograms and callback-driven families."""
+
+from __future__ import annotations
+
+import gc
+import math
+import os
+import platform
+import resource
+import threading
+import time
+from collections.abc import Callable, Iterable
+
+LATENCY_BUCKETS = (0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0)
+CONTENT_TYPE = "application/openmetrics-text; version=1.0.0; charset=utf-8"
+
+Labels = tuple[str, ...]
+Sample = tuple[str, Labels, float]
+PROCESS_START = time.time()
+
+
+def _escape(value: str) -> str:
+    return value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n")
+
+
+def _format_value(value: float) -> str:
+    if math.isinf(value):
+        return "+Inf" if value > 0 else "-Inf"
+    if math.isnan(value):
+        return "NaN"
+    if float(value).is_integer() and abs(value) < 1e15:
+        return str(int(value))
+    return repr(float(value))
+
+
+def _format_bound(value: float) -> str:
+    return "+Inf" if math.isinf(value) else repr(float(value))
+
+
+class Family:
+    kind = "gauge"
+
+    def __init__(self, name: str, help_text: str, labelnames: Labels = ()) -> None:
+        self.name = name
+        self.help_text = help_text
+        self.labelnames = labelnames
+        self._lock = threading.Lock()
+
+    @property
+    def exposition_name(self) -> str:
+        if self.kind == "counter" and self.name.endswith("_total"):
+            return self.name[: -len("_total")]
+        return self.name
+
+    def samples(self) -> Iterable[Sample]:
+        raise NotImplementedError
+
+
+class Counter(Family):
+    kind = "counter"
+
+    def __init__(self, name: str, help_text: str, labelnames: Labels = ()) -> None:
+        super().__init__(name, help_text, labelnames)
+        self._values: dict[Labels, float] = {}
+
+    def inc(self, *labels: str, amount: float = 1.0) -> None:
+        with self._lock:
+            self._values[labels] = self._values.get(labels, 0.0) + amount
+
+    def touch(self, *labels: str) -> None:
+        with self._lock:
+            self._values.setdefault(labels, 0.0)
+
+    def samples(self) -> Iterable[Sample]:
+        with self._lock:
+            items = list(self._values.items())
+        for labels, value in items:
+            yield ("_total", labels, value)
+
+
+class Gauge(Family):
+    kind = "gauge"
+
+    def __init__(self, name: str, help_text: str, labelnames: Labels = ()) -> None:
+        super().__init__(name, help_text, labelnames)
+        self._values: dict[Labels, float] = {}
+
+    def set(self, *labels: str, value: float) -> None:
+        with self._lock:
+            self._values[labels] = value
+
+    def inc(self, *labels: str, amount: float = 1.0) -> None:
+        with self._lock:
+            self._values[labels] = self._values.get(labels, 0.0) + amount
+
+    def dec(self, *labels: str, amount: float = 1.0) -> None:
+        self.inc(*labels, amount=-amount)
+
+    def touch(self, *labels: str) -> None:
+        with self._lock:
+            self._values.setdefault(labels, 0.0)
+
+    def samples(self) -> Iterable[Sample]:
+        with self._lock:
+            items = list(self._values.items())
+        for labels, value in items:
+            yield ("", labels, value)
+
+
+class Histogram(Family):
+    kind = "histogram"
+
+    def __init__(
+        self,
+        name: str,
+        help_text: str,
+        labelnames: Labels = (),
+        buckets: tuple[float, ...] = LATENCY_BUCKETS,
+    ) -> None:
+        super().__init__(name, help_text, labelnames)
+        self.buckets = buckets
+        self._states: dict[Labels, tuple[list[int], list[float]]] = {}
+
+    def observe(self, *labels: str, value: float) -> None:
+        with self._lock:
+            state = self._states.get(labels)
+            if state is None:
+                state = ([0] * (len(self.buckets) + 1), [0.0])
+                self._states[labels] = state
+            counts, total = state
+            for index, bound in enumerate(self.buckets):
+                if value <= bound:
+                    counts[index] += 1
+                    break
+            else:
+                counts[-1] += 1
+            total[0] += value
+
+    def samples(self) -> Iterable[Sample]:
+        with self._lock:
+            items = [
+                (labels, list(counts), total[0]) for labels, (counts, total) in self._states.items()
+            ]
+        for labels, counts, total in items:
+            cumulative = 0
+            for index, bound in enumerate(self.buckets):
+                cumulative += counts[index]
+                yield ("_bucket", (*labels, _format_bound(bound)), cumulative)
+            cumulative += counts[-1]
+            yield ("_bucket", (*labels, "+Inf"), cumulative)
+            yield ("_count", labels, cumulative)
+            yield ("_sum", labels, total)
+
+
+class CallbackFamily(Family):
+    """A family whose samples are computed at scrape time from data the process already holds."""
+
+    def __init__(
+        self,
+        kind: str,
+        name: str,
+        help_text: str,
+        labelnames: Labels,
+        callback: Callable[[], Iterable[tuple[Labels, float]]],
+    ) -> None:
+        super().__init__(name, help_text, labelnames)
+        self.kind = kind
+        self.callback = callback
+
+    def samples(self) -> Iterable[Sample]:
+        suffix = "_total" if self.kind == "counter" else ""
+        for labels, value in self.callback():
+            yield (suffix, labels, value)
+
+
+class Registry:
+    def __init__(self) -> None:
+        self.families: list[Family] = []
+
+    def register[F: Family](self, family: F) -> F:
+        self.families.append(family)
+        return family
+
+    def render(self) -> str:
+        out: list[str] = []
+        for family in self.families:
+            name = family.exposition_name
+            out.append(f"# HELP {name} {_escape(family.help_text)}\n# TYPE {name} {family.kind}\n")
+            for suffix, labels, value in family.samples():
+                names = (*family.labelnames, "le") if suffix == "_bucket" else family.labelnames
+                pairs = ",".join(
+                    f'{k}="{_escape(str(v))}"' for k, v in zip(names, labels, strict=True)
+                )
+                if pairs:
+                    out.append(f"{name}{suffix}{{{pairs}}} {_format_value(value)}\n")
+                else:
+                    out.append(f"{name}{suffix} {_format_value(value)}\n")
+        out.append("# EOF\n")
+        return "".join(out)
+
+
+def _statm() -> tuple[int, int]:
+    with open("/proc/self/statm", encoding="ascii") as handle:
+        size, resident = handle.read().split()[:2]
+    page = os.sysconf("SC_PAGE_SIZE")
+    return int(size) * page, int(resident) * page
+
+
+def _cpu_seconds() -> Iterable[tuple[Labels, float]]:
+    usage = resource.getrusage(resource.RUSAGE_SELF)
+    return [((), usage.ru_utime + usage.ru_stime)]
+
+
+def _gc_stat(key: str) -> Callable[[], Iterable[tuple[Labels, float]]]:
+    return lambda: [((str(gen),), float(stat[key])) for gen, stat in enumerate(gc.get_stats())]
+
+
+def register_process_families(registry: Registry) -> None:
+    families = [
+        (
+            "gauge",
+            "process_start_time_seconds",
+            "Start time of the process since unix epoch.",
+            (),
+            lambda: [((), PROCESS_START)],
+        ),
+        (
+            "counter",
+            "process_cpu_seconds_total",
+            "Total user and system CPU time.",
+            (),
+            _cpu_seconds,
+        ),
+        (
+            "gauge",
+            "process_resident_memory_bytes",
+            "Resident memory size.",
+            (),
+            lambda: [((), float(_statm()[1]))],
+        ),
+        (
+            "gauge",
+            "process_virtual_memory_bytes",
+            "Virtual memory size.",
+            (),
+            lambda: [((), float(_statm()[0]))],
+        ),
+        (
+            "gauge",
+            "process_open_fds",
+            "Number of open file descriptors.",
+            (),
+            lambda: [((), float(len(os.listdir("/proc/self/fd"))))],
+        ),
+        (
+            "gauge",
+            "process_max_fds",
+            "Maximum number of open file descriptors.",
+            (),
+            lambda: [((), float(resource.getrlimit(resource.RLIMIT_NOFILE)[0]))],
+        ),
+        (
+            "gauge",
+            "python_info",
+            "The Python runtime compiled into the binary.",
+            ("implementation", "version"),
+            lambda: [((platform.python_implementation(), platform.python_version()), 1.0)],
+        ),
+        (
+            "gauge",
+            "python_threads",
+            "Live threads of the process.",
+            (),
+            lambda: [((), float(threading.active_count()))],
+        ),
+        (
+            "counter",
+            "python_gc_collections_total",
+            "Garbage collections per generation.",
+            ("generation",),
+            _gc_stat("collections"),
+        ),
+        (
+            "counter",
+            "python_gc_objects_collected_total",
+            "Objects collected per generation.",
+            ("generation",),
+            _gc_stat("collected"),
+        ),
+        (
+            "counter",
+            "python_gc_objects_uncollectable_total",
+            "Uncollectable objects found per generation.",
+            ("generation",),
+            _gc_stat("uncollectable"),
+        ),
+    ]
+    for kind, name, help_text, labelnames, callback in families:
+        registry.register(CallbackFamily(kind, name, help_text, labelnames, callback))
