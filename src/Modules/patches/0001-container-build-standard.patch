@@ -0,0 +1,50 @@
+"""The exec-style probe command: a local GET against the admin listener, exit 0 on 200."""
+
+from __future__ import annotations
+
+import http.client
+import os
+import sys
+
+ENDPOINTS = ("startupz", "livez", "readyz")
+
+
+def probe_host(bind_addr: str) -> str:
+    if bind_addr in ("", "0.0.0.0", "*"):
+        return "127.0.0.1"
+    if bind_addr == "::":
+        return "::1"
+    return bind_addr
+
+
+def main(argv: list[str]) -> int:
+    endpoint = "livez"
+    for arg in argv:
+        if arg.startswith("--endpoint="):
+            endpoint = arg.split("=", 1)[1]
+        else:
+            print(
+                f"unknown argument {arg!r}; usage: healthcheck --endpoint=<startupz|livez|readyz>",
+                file=sys.stderr,
+            )
+            return 1
+    if endpoint not in ENDPOINTS:
+        print(f"unknown endpoint {endpoint!r}; allowed: {', '.join(ENDPOINTS)}", file=sys.stderr)
+        return 1
+    host = probe_host(os.environ.get("BIND_ADDR", "").strip())
+    raw_port = os.environ.get("ADMIN_PORT", "").strip() or "9090"
+    try:
+        port = int(raw_port)
+    except ValueError:
+        print(f"ADMIN_PORT={raw_port!r} is not an integer", file=sys.stderr)
+        return 1
+    try:
+        connection = http.client.HTTPConnection(host, port, timeout=3)
+        connection.request("GET", f"/{endpoint}")
+        response = connection.getresponse()
+        response.read()
+        connection.close()
+    except OSError as exc:
+        print(f"probe failed: {exc}", file=sys.stderr)
+        return 1
+    return 0 if response.status == 200 else 1
