#!/bin/sh
echo `# <#` >/dev/null
# ---------------------------------- POSIX sh ----------------------------------
set -eu
VCS_REF=$(git rev-parse --short HEAD 2>/dev/null || echo adhoc)
BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
podman manifest rm localhost/user-mgmt-service:0.0.1 >/dev/null 2>&1 || true
podman build --platform linux/amd64 -t localhost/user-mgmt-service:0.0.1-amd64 --build-arg VCS_REF="$VCS_REF" --build-arg BUILD_DATE="$BUILD_DATE" -f Containerfile .
