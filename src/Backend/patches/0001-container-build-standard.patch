@@ -0,0 +1,39 @@
+package com.example.jwt.ops;
+
+import java.io.IOException;
+
+/**
+ * Process-wide holder wiring the ops machinery started in main() (before the
+ * Spring context exists) to the Spring-managed pieces registered once the
+ * context is ready.
+ */
+public final class Ops {
+
+  private static volatile OpsConfig config;
+  private static volatile HealthState state;
+  private static volatile HealthChecker checker;
+  private static volatile AdminServer admin;
+
+  private Ops() {}
+
+  public static void bootstrap(OpsConfig cfg) throws IOException {
+    config = cfg;
+    state = new HealthState();
+    checker = new HealthChecker(cfg, state);
+    admin = new AdminServer(cfg, state);
+    admin.start();
+    checker.start();
+  }
+
+  public static OpsConfig config() {
+    return config;
+  }
+
+  public static HealthState state() {
+    return state;
+  }
+
+  public static void registerCheck(HealthCheck check) {
+    checker.register(check);
+  }
+}
