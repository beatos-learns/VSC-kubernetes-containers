+++ b/src/main/java/com/example/jwt/ops/HealthState.java
@@ -0,0 +1,67 @@
+package com.example.jwt.ops;
+
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Shared, lock-free health state read by the admin endpoints. */
+public final class HealthState {
+
+  private final AtomicReference<HealthSnapshot> snapshot =
+      new AtomicReference<>(new HealthSnapshot(Map.of(), 0L));
+  private final AtomicLong cycles = new AtomicLong();
+  private volatile boolean started;
+  private volatile boolean draining;
+  private volatile boolean contextReady;
+
+  public HealthSnapshot snapshot() {
+    return snapshot.get();
+  }
+
+  public void swapSnapshot(HealthSnapshot next) {
+    snapshot.set(next);
+    cycles.incrementAndGet();
+  }
+
+  /** Completed checker cycles since process start. */
+  public long cycles() {
+    return cycles.get();
+  }
+
+  public boolean started() {
+    return started;
+  }
+
+  public void latchStarted() {
+    started = true;
+  }
+
+  public boolean draining() {
+    return draining;
+  }
+
+  public void latchDraining() {
+    draining = true;
+  }
+
+  public boolean contextReady() {
+    return contextReady;
+  }
+
+  public void markContextReady() {
+    contextReady = true;
+  }
+
+  public boolean fresh(OpsConfig config, long nowMillis) {
+    long ageMillis = nowMillis - snapshot.get().takenAtMillis();
+    return ageMillis <= (long) (config.healthStaleFactor() * config.healthCheckInterval() * 1000.0);
+  }
+
+  public boolean live(OpsConfig config, long nowMillis) {
+    return fresh(config, nowMillis);
+  }
+
+  public boolean ready(OpsConfig config, long nowMillis) {
+    return fresh(config, nowMillis) && snapshot.get().allOk() && !draining;
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/OpenMetricsExposition.java b/src/main/java/com/example/jwt/ops/OpenMetricsExposition.java
new file mode 100644
index 0000000..27b3616
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/OpenMetricsExposition.java
@@ -0,0 +1,169 @@
+package com.example.jwt.ops;
+
+import java.util.Map;
+
+/**
+ * Composes the OpenMetrics body served on ADMIN_PORT: the application's
+ * registry output (normalised to HELP/TYPE/UNIT order with a HELP line for
+ * every family, its own terminator removed), then the ops families the image
+ * contract promises independently of the framework, then one final "# EOF".
+ */
+public final class OpenMetricsExposition {
+
+  public static final String CONTENT_TYPE =
+      "application/openmetrics-text; version=1.0.0; charset=utf-8";
+
+  private OpenMetricsExposition() {}
+
+  public static String compose(String registryScrape, HealthState state, long nowMillis,
+      String version, String revision) {
+    StringBuilder body = new StringBuilder(registryScrape == null ? 2048 : registryScrape.length() + 2048);
+    if (registryScrape != null && !registryScrape.isEmpty()) {
+      normalize(registryScrape, body);
+    }
+    opsFamilies(state, nowMillis, version, revision, body);
+    body.append("# EOF\n");
+    return body.toString();
+  }
+
+  /**
+   * The Prometheus Java client writes "# TYPE" before "# HELP" and omits the
+   * HELP line for meters without a description; classic tooling (promtool
+   * lint) expects HELP first and present. Metadata lines of one family are
+   * buffered and re-emitted as HELP, TYPE, UNIT; "# EOF" is dropped so the
+   * caller can append its own families.
+   */
+  static void normalize(String scrape, StringBuilder out) {
+    String name = null;
+    String help = null;
+    String type = null;
+    String unit = null;
+    int start = 0;
+    int length = scrape.length();
+    while (start < length) {
+      int end = scrape.indexOf('\n', start);
+      if (end < 0) {
+        end = length;
+      }
+      String line = scrape.substring(start, end);
+      start = end + 1;
+      if (line.equals("# EOF")) {
+        continue;
+      }
+      String kind = metadataKind(line);
+      if (kind != null) {
+        int nameStart = 2 + kind.length() + 1;
+        int nameEnd = line.indexOf(' ', nameStart);
+        String lineName = nameEnd < 0 ? line.substring(nameStart) : line.substring(nameStart, nameEnd);
+        if (!lineName.equals(name)) {
+          flush(name, help, type, unit, out);
+          name = lineName;
+          help = null;
+          type = null;
+          unit = null;
+        }
+        switch (kind) {
+          case "HELP" -> help = line;
+          case "TYPE" -> type = line;
+          default -> unit = line;
+        }
+        continue;
+      }
+      flush(name, help, type, unit, out);
+      name = null;
+      help = null;
+      type = null;
+      unit = null;
+      out.append(line).append('\n');
+    }
+    flush(name, help, type, unit, out);
+  }
+
+  private static String metadataKind(String line) {
+    if (line.startsWith("# HELP ")) {
+      return "HELP";
+    }
+    if (line.startsWith("# TYPE ")) {
+      return "TYPE";
+    }
+    if (line.startsWith("# UNIT ")) {
+      return "UNIT";
+    }
+    return null;
+  }
+
+  private static void flush(String name, String help, String type, String unit, StringBuilder out) {
+    if (name == null) {
+      return;
+    }
+    if (help == null || help.substring(Math.min(help.length(), 7 + name.length())).isBlank()) {
+      out.append("# HELP ").append(name).append(" Micrometer meter ").append(name)
+          .append(" (no description registered).\n");
+    } else {
+      out.append(help).append('\n');
+    }
+    if (type != null) {
+      out.append(type).append('\n');
+    }
+    if (unit != null) {
+      out.append(unit).append('\n');
+    }
+  }
+
+  static void opsFamilies(HealthState state, long nowMillis, String version, String revision,
+      StringBuilder out) {
+    HealthSnapshot snapshot = state.snapshot();
+    out.append("# HELP build_info The running artifact: packaged-software version and VCS revision (always 1).\n")
+        .append("# TYPE build_info gauge\n")
+        .append("build_info{version=\"").append(escape(version)).append("\",revision=\"")
+        .append(escape(revision)).append("\"} 1\n");
+
+    out.append("# HELP health_check_up 1 when the check passed in the last checker cycle.\n")
+        .append("# TYPE health_check_up gauge\n");
+    for (Map.Entry<String, HealthSnapshot.CheckResult> entry : snapshot.results().entrySet()) {
+      out.append("health_check_up{check=\"").append(escape(entry.getKey())).append("\"} ")
+          .append(entry.getValue().ok() ? 1 : 0).append('\n');
+    }
+
+    out.append("# HELP health_check_duration_seconds Duration of the last run of the check.\n")
+        .append("# TYPE health_check_duration_seconds gauge\n");
+    for (Map.Entry<String, HealthSnapshot.CheckResult> entry : snapshot.results().entrySet()) {
+      out.append("health_check_duration_seconds{check=\"").append(escape(entry.getKey())).append("\"} ")
+          .append(entry.getValue().durationNanos() / 1e9).append('\n');
+    }
+
+    out.append("# HELP health_check_last_success_timestamp_seconds Unix time of the last pass of the check (0 until it first passed).\n")
+        .append("# TYPE health_check_last_success_timestamp_seconds gauge\n");
+    for (Map.Entry<String, HealthSnapshot.CheckResult> entry : snapshot.results().entrySet()) {
+      out.append("health_check_last_success_timestamp_seconds{check=\"").append(escape(entry.getKey()))
+          .append("\"} ").append(entry.getValue().lastSuccessMillis() / 1e3).append('\n');
+    }
+
+    double age = snapshot.takenAtMillis() == 0 ? 0.0 : (nowMillis - snapshot.takenAtMillis()) / 1e3;
+    out.append("# HELP health_snapshot_age_seconds Age of the cached health snapshot the probes read.\n")
+        .append("# TYPE health_snapshot_age_seconds gauge\n")
+        .append("health_snapshot_age_seconds ").append(age).append('\n');
+
+    out.append("# HELP health_checker_cycles Completed health checker cycles since process start.\n")
+        .append("# TYPE health_checker_cycles counter\n")
+        .append("health_checker_cycles_total ").append(state.cycles()).append('\n');
+
+    out.append("# HELP health_draining 1 once the shutdown drain latch is set (readiness is 503 from then on).\n")
+        .append("# TYPE health_draining gauge\n")
+        .append("health_draining ").append(state.draining() ? 1 : 0).append('\n');
+  }
+
+  private static String escape(String value) {
+    StringBuilder sb = new StringBuilder(value.length());
+    for (int i = 0; i < value.length(); i++) {
+      char c = value.charAt(i);
+      switch (c) {
+        case '\\' -> sb.append("\\\\");
+        case '"' -> sb.append("\\\"");
+        case '\n' -> sb.append("\\n");
+        default -> sb.append(c);
+      }
+    }
+    return sb.toString();
+  }
+}
