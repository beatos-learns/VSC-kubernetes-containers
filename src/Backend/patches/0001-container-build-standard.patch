@@ -0,0 +1,59 @@
+package com.example.jwt.ops;
+
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Shared, lock-free health state read by the admin endpoints. */
+public final class HealthState {
+
+  private final AtomicReference<HealthSnapshot> snapshot =
+      new AtomicReference<>(new HealthSnapshot(Map.of(), 0L));
+  private volatile boolean started;
+  private volatile boolean draining;
+  private volatile boolean contextReady;
+
+  public HealthSnapshot snapshot() {
+    return snapshot.get();
+  }
+
+  public void swapSnapshot(HealthSnapshot next) {
+    snapshot.set(next);
+  }
+
+  public boolean started() {
+    return started;
+  }
+
+  public void latchStarted() {
+    started = true;
+  }
+
+  public boolean draining() {
+    return draining;
+  }
+
+  public void latchDraining() {
+    draining = true;
+  }
+
+  public boolean contextReady() {
+    return contextReady;
+  }
+
+  public void markContextReady() {
+    contextReady = true;
+  }
+
+  public boolean fresh(OpsConfig config, long nowMillis) {
+    long ageMillis = nowMillis - snapshot.get().takenAtMillis();
+    return ageMillis <= (long) (config.healthStaleFactor() * config.healthCheckInterval() * 1000.0);
+  }
+
+  public boolean live(OpsConfig config, long nowMillis) {
+    return fresh(config, nowMillis);
+  }
+
+  public boolean ready(OpsConfig config, long nowMillis) {
+    return fresh(config, nowMillis) && snapshot.get().allOk() && !draining;
+  }
+}
