+++ b/src/main/java/com/example/jwt/ops/OpsRuntimeHints.java
@@ -0,0 +1,15 @@
+package com.example.jwt.ops;
+
+import org.springframework.aot.hint.RuntimeHints;
+import org.springframework.aot.hint.RuntimeHintsRegistrar;
+
+/** Resource bundles resolved reflectively at runtime need explicit native-image hints. */
+public class OpsRuntimeHints implements RuntimeHintsRegistrar {
+
+  @Override
+  public void registerHints(RuntimeHints hints, ClassLoader classLoader) {
+    hints.resources().registerResourceBundle("messages");
+    hints.resources().registerResourceBundle("validationMessages");
+    hints.reflection().registerType(java.util.UUID[].class);
+  }
+}
