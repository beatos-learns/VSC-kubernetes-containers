diff --git a/src/main/java/com/example/jwt/ops/AdminServer.java b/src/main/java/com/example/jwt/ops/AdminServer.java
new file mode 100644
index 0000000..21582c8
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/AdminServer.java
@@ -0,0 +1,104 @@
+package com.example.jwt.ops;
+
+import com.sun.net.httpserver.HttpExchange;
+import com.sun.net.httpserver.HttpServer;
+import io.micrometer.prometheusmetrics.PrometheusMeterRegistry;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import java.util.concurrent.Executors;
+import java.util.function.BooleanSupplier;
+
+/**
+ * Probe and metrics listener on ADMIN_PORT. Handlers are O(1) reads of the
+ * cached snapshot; probe hits are deliberately not logged.
+ */
+public final class AdminServer {
+
+  private final OpsConfig config;
+  private final HealthState state;
+  private HttpServer server;
+
+  public AdminServer(OpsConfig config, HealthState state) {
+    this.config = config;
+    this.state = state;
+  }
+
+  public void start() throws IOException {
+    server = HttpServer.create(new InetSocketAddress(config.bindAddr(), config.adminPort()), 0);
+    server.setExecutor(Executors.newFixedThreadPool(2, runnable -> {
+      Thread thread = new Thread(runnable, "admin-http");
+      thread.setDaemon(true);
+      return thread;
+    }));
+    server.createContext("/startupz", exchange -> probe(exchange, state::started));
+    server.createContext("/livez",
+        exchange -> probe(exchange, () -> state.live(config, System.currentTimeMillis())));
+    server.createContext("/readyz",
+        exchange -> probe(exchange, () -> state.ready(config, System.currentTimeMillis())));
+    server.createContext("/metrics", this::metrics);
+    server.start();
+  }
+
+  private void probe(HttpExchange exchange, BooleanSupplier up) throws IOException {
+    boolean ok = up.getAsBoolean();
+    String body = (exchange.getRequestURI().getQuery() != null
+        && exchange.getRequestURI().getQuery().contains("verbose=1"))
+            ? verboseBody(ok)
+            : (ok ? "ok" : "unavailable");
+    respond(exchange, ok ? 200 : 503, body,
+        body.startsWith("{") ? "application/json" : "text/plain; charset=utf-8");
+  }
+
+  private String verboseBody(boolean ok) {
+    HealthSnapshot snapshot = state.snapshot();
+    StringBuilder json = new StringBuilder("{\"status\":\"").append(ok ? "ok" : "unavailable")
+        .append("\",\"draining\":").append(state.draining())
+        .append(",\"snapshotAgeMillis\":")
+        .append(snapshot.takenAtMillis() == 0 ? -1 : System.currentTimeMillis() - snapshot.takenAtMillis())
+        .append(",\"checks\":{");
+    boolean first = true;
+    for (Map.Entry<String, HealthSnapshot.CheckResult> entry : snapshot.results().entrySet()) {
+      if (!first) {
+        json.append(',');
+      }
+      first = false;
+      json.append('"').append(entry.getKey()).append("\":{\"ok\":").append(entry.getValue().ok())
+          .append(",\"detail\":\"").append(entry.getValue().detail().replace("\"", "'"))
+          .append("\",\"durationMillis\":").append(entry.getValue().durationNanos() / 1_000_000L)
+          .append(",\"lastSuccessMillis\":").append(entry.getValue().lastSuccessMillis())
+          .append('}');
+    }
+    return json.append("}}").toString();
+  }
+
+  /**
+   * The application registry (when the context has handed it over) in front of
+   * the ops families; before that, the ops families alone — still 200, still
+   * OpenMetrics, so a scrape never depends on the framework being up.
+   */
+  private void metrics(HttpExchange exchange) throws IOException {
+    PrometheusMeterRegistry registry = Ops.meterRegistry();
+    String scrape = registry == null ? null : registry.scrape(OpenMetricsExposition.CONTENT_TYPE);
+    String body = OpenMetricsExposition.compose(scrape, state, System.currentTimeMillis(),
+        envOr("APP_VERSION", "dev"), envOr("APP_REVISION", "unknown"));
+    respond(exchange, 200, body, OpenMetricsExposition.CONTENT_TYPE);
+  }
+
+  private static void respond(HttpExchange exchange, int status, String body, String contentType)
+      throws IOException {
+    byte[] bytes = body.getBytes(StandardCharsets.UTF_8);
+    exchange.getResponseHeaders().set("Content-Type", contentType);
+    exchange.sendResponseHeaders(status, bytes.length);
+    try (OutputStream out = exchange.getResponseBody()) {
+      out.write(bytes);
+    }
+  }
+
+  private static String envOr(String name, String fallback) {
+    String value = System.getenv(name);
+    return (value == null || value.isBlank()) ? fallback : value;
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/EcsFlatFormatter.java b/src/main/java/com/example/jwt/ops/EcsFlatFormatter.java
new file mode 100644
index 0000000..e22aac0
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/EcsFlatFormatter.java
@@ -0,0 +1,101 @@
+package com.example.jwt.ops;
+
+import ch.qos.logback.classic.spi.ILoggingEvent;
+import ch.qos.logback.classic.spi.IThrowableProxy;
+import ch.qos.logback.classic.spi.ThrowableProxyUtil;
+import java.time.format.DateTimeFormatter;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import org.slf4j.event.KeyValuePair;
+import org.springframework.boot.logging.structured.StructuredLogFormatter;
+
+/**
+ * The log shape shared by every image of the stack: one JSON object per line
+ * with flat, dotted ECS field names (Spring Boot's built-in ECS format nests
+ * them), lower-case levels, the fixed service fields, MDC entries and
+ * key-value pairs as top-level members. Selected through
+ * {@code logging.structured.format.console} when LOG_FORMAT=json.
+ */
+public final class EcsFlatFormatter implements StructuredLogFormatter<ILoggingEvent> {
+
+  private static final String SERVICE_NAME = "user-mgmt-service";
+  private static final String SERVICE_VERSION = envOr("APP_VERSION", "dev");
+  private static final long PID = ProcessHandle.current().pid();
+
+  public EcsFlatFormatter() {}
+
+  @Override
+  public String format(ILoggingEvent event) {
+    StringBuilder out = new StringBuilder(320);
+    out.append("{\"@timestamp\":\"").append(DateTimeFormatter.ISO_INSTANT.format(event.getInstant())).append('"');
+    text(out, "log.level", event.getLevel().toString().toLowerCase(Locale.ROOT));
+    text(out, "log.logger", event.getLoggerName());
+    text(out, "message", event.getFormattedMessage());
+    text(out, "ecs.version", "8.11");
+    text(out, "service.name", SERVICE_NAME);
+    text(out, "service.version", SERVICE_VERSION);
+    out.append(",\"process.pid\":").append(PID);
+    text(out, "process.thread.name", event.getThreadName());
+    Map<String, String> mdc = event.getMDCPropertyMap();
+    if (mdc != null) {
+      for (Map.Entry<String, String> entry : mdc.entrySet()) {
+        text(out, entry.getKey(), entry.getValue());
+      }
+    }
+    List<KeyValuePair> pairs = event.getKeyValuePairs();
+    if (pairs != null) {
+      for (KeyValuePair pair : pairs) {
+        value(out, pair.key, pair.value);
+      }
+    }
+    IThrowableProxy throwable = event.getThrowableProxy();
+    if (throwable != null) {
+      text(out, "error.type", throwable.getClassName());
+      text(out, "error.message", throwable.getMessage());
+      text(out, "error.stack_trace", ThrowableProxyUtil.asString(throwable));
+    }
+    return out.append("}\n").toString();
+  }
+
+  private static void value(StringBuilder out, String key, Object value) {
+    if (value instanceof Number || value instanceof Boolean) {
+      out.append(",\"").append(escape(key)).append("\":").append(value);
+    } else {
+      text(out, key, String.valueOf(value));
+    }
+  }
+
+  private static void text(StringBuilder out, String key, String value) {
+    out.append(",\"").append(escape(key)).append("\":\"").append(escape(value == null ? "" : value)).append('"');
+  }
+
+  private static String escape(String value) {
+    StringBuilder sb = null;
+    for (int i = 0; i < value.length(); i++) {
+      char c = value.charAt(i);
+      String replacement = switch (c) {
+        case '"' -> "\\\"";
+        case '\\' -> "\\\\";
+        case '\n' -> "\\n";
+        case '\r' -> "\\r";
+        case '\t' -> "\\t";
+        default -> c < 0x20 ? String.format("\\u%04x", (int) c) : null;
+      };
+      if (replacement != null) {
+        if (sb == null) {
+          sb = new StringBuilder(value.length() + 16).append(value, 0, i);
+        }
+        sb.append(replacement);
+      } else if (sb != null) {
+        sb.append(c);
+      }
+    }
+    return sb == null ? value : sb.toString();
+  }
+
+  private static String envOr(String name, String fallback) {
+    String value = System.getenv(name);
+    return (value == null || value.isBlank()) ? fallback : value;
+  }
+}
