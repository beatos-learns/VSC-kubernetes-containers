+package com.example.jwt.ops;
+
+import com.example.jwt.core.security.helpers.Credentials;
+import java.sql.Connection;
+import java.sql.Statement;
+import javax.sql.DataSource;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.aot.hint.annotation.RegisterReflectionForBinding;
+import org.springframework.boot.context.event.ApplicationReadyEvent;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.ImportRuntimeHints;
+import org.springframework.context.event.EventListener;
+
+/**
+ * Registers the service-function-derived checks once the context is up. The
+ * reflection hint covers the hand-instantiated ObjectMapper deserialization of
+ * Credentials in CustomAuthenticationFilter, which Spring AOT cannot discover.
+ */
+@Configuration(proxyBeanMethods = false)
+@ImportRuntimeHints(OpsRuntimeHints.class)
+@RegisterReflectionForBinding(Credentials.class)
+public class OpsBootstrap {
+
+  private static final Logger log = LoggerFactory.getLogger(OpsBootstrap.class);
+
+  private final DataSource dataSource;
+
+  public OpsBootstrap(DataSource dataSource) {
+    this.dataSource = dataSource;
+  }
+
+  @EventListener(ApplicationReadyEvent.class)
+  public void onApplicationReady() {
+    OpsConfig config = Ops.config();
+    Ops.registerCheck(new HealthCheck() {
+      @Override
+      public String name() {
+        return "database";
+      }
+
+      @Override
+      public void run() throws Exception {
+        try (Connection connection = dataSource.getConnection();
+            Statement statement = connection.createStatement()) {
+          statement.setQueryTimeout(config.healthCheckTimeout());
+          statement.execute("SELECT 1");
+        }
+      }
+    });
+    Ops.state().markContextReady();
+    log.info("user-mgmt-service started: version={} revision={} config[{}]",
+        System.getenv().getOrDefault("APP_VERSION", "dev"),
+        System.getenv().getOrDefault("APP_REVISION", "unknown"),
+        config.redactedSummary());
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/OpsConfig.java b/src/main/java/com/example/jwt/ops/OpsConfig.java
new file mode 100644
index 0000000..f1d17e1
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/OpsConfig.java
@@ -0,0 +1,96 @@
+package com.example.jwt.ops;
+
+import java.util.List;
+
+/**
+ * Runtime configuration surface of the container image contract. Parsed and
+ * validated once at process start; any violation aborts startup immediately.
+ */
+public record OpsConfig(
+    int port,
+    int adminPort,
+    String bindAddr,
+    String logLevel,
+    String logFormat,
+    int healthCheckInterval,
+    int healthCheckTimeout,
+    double healthStaleFactor,
+    int shutdownDrainDelay,
+    int shutdownTimeout) {
+
+  public static OpsConfig fromEnvironment() {
+    int port = intEnv("PORT", 8080, 1, 65535);
+    int adminPort = intEnv("ADMIN_PORT", 9090, 1, 65535);
+    String bindAddr = env("BIND_ADDR", "0.0.0.0");
+    String logLevel = enumEnv("LOG_LEVEL", "info", List.of("trace", "debug", "info", "warn", "error"));
+    String logFormat = enumEnv("LOG_FORMAT", "json", List.of("json", "text"));
+    int interval = intEnv("HEALTH_CHECK_INTERVAL", 5, 1, 3600);
+    int timeout = intEnv("HEALTH_CHECK_TIMEOUT", 2, 1, 3600);
+    double staleFactor = doubleEnv("HEALTH_STALE_FACTOR", 3.0, 1.0, 100.0);
+    int drainDelay = intEnv("SHUTDOWN_DRAIN_DELAY", 3, 0, 600);
+    int shutdownTimeout = intEnv("SHUTDOWN_TIMEOUT", 10, 1, 3600);
+    if (timeout >= interval) {
+      throw new IllegalStateException(
+          "HEALTH_CHECK_TIMEOUT (" + timeout + "s) must be smaller than HEALTH_CHECK_INTERVAL (" + interval + "s)");
+    }
+    if (port == adminPort) {
+      throw new IllegalStateException("PORT and ADMIN_PORT must differ (both " + port + ")");
+    }
+    return new OpsConfig(port, adminPort, bindAddr, logLevel, logFormat,
+        interval, timeout, staleFactor, drainDelay, shutdownTimeout);
+  }
+
+  public String redactedSummary() {
+    return "PORT=" + port
+        + " ADMIN_PORT=" + adminPort
+        + " BIND_ADDR=" + bindAddr
+        + " LOG_LEVEL=" + logLevel
+        + " LOG_FORMAT=" + logFormat
+        + " HEALTH_CHECK_INTERVAL=" + healthCheckInterval
+        + " HEALTH_CHECK_TIMEOUT=" + healthCheckTimeout
+        + " HEALTH_STALE_FACTOR=" + healthStaleFactor
+        + " SHUTDOWN_DRAIN_DELAY=" + shutdownDrainDelay
+        + " SHUTDOWN_TIMEOUT=" + shutdownTimeout;
+  }
+
+  private static String env(String name, String fallback) {
+    String value = System.getenv(name);
+    return (value == null || value.isBlank()) ? fallback : value.trim();
+  }
+
+  private static String enumEnv(String name, String fallback, List<String> allowed) {
+    String value = env(name, fallback).toLowerCase();
+    if (!allowed.contains(value)) {
+      throw new IllegalStateException(name + "=" + value + " is invalid; allowed: " + allowed);
+    }
+    return value;
+  }
+
+  private static int intEnv(String name, int fallback, int min, int max) {
+    String raw = env(name, Integer.toString(fallback));
+    int value;
+    try {
+      value = Integer.parseInt(raw);
+    } catch (NumberFormatException e) {
+      throw new IllegalStateException(name + "=" + raw + " is not an integer");
+    }
+    if (value < min || value > max) {
+      throw new IllegalStateException(name + "=" + value + " is outside [" + min + ", " + max + "]");
+    }
+    return value;
+  }
+
+  private static double doubleEnv(String name, double fallback, double min, double max) {
+    String raw = env(name, Double.toString(fallback));
+    double value;
+    try {
+      value = Double.parseDouble(raw);
+    } catch (NumberFormatException e) {
+      throw new IllegalStateException(name + "=" + raw + " is not a number");
+    }
+    if (value < min || value > max) {
+      throw new IllegalStateException(name + "=" + value + " is outside [" + min + ", " + max + "]");
+    }
+    return value;
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/OpsRuntimeHints.java b/src/main/java/com/example/jwt/ops/OpsRuntimeHints.java
