+package com.example.jwt.ops;
+
+/** One registered readiness check; executed concurrently each cycle, bounded by HEALTH_CHECK_TIMEOUT. */
+public interface HealthCheck {
+
+  String name();
+
+  /** Returns on success; throws on failure. */
