diff --git a/src/main/java/com/example/jwt/ops/HealthChecker.java b/src/main/java/com/example/jwt/ops/HealthChecker.java
new file mode 100644
index 0000000..f8acbfc
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/HealthChecker.java
@@ -0,0 +1,122 @@
+package com.example.jwt.ops;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.ThreadFactory;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * The single background loop owning all real checks. Endpoints only read the
+ * atomic snapshot this loop swaps in once per HEALTH_CHECK_INTERVAL.
+ */
+public final class HealthChecker implements Runnable {
+
+  private static final Logger log = LoggerFactory.getLogger(HealthChecker.class);
+
+  private final OpsConfig config;
+  private final HealthState state;
+  private final List<HealthCheck> checks = new CopyOnWriteArrayList<>();
+  private final ExecutorService executor;
+
+  public HealthChecker(OpsConfig config, HealthState state) {
+    this.config = config;
+    this.state = state;
+    ThreadFactory daemonFactory = runnable -> {
+      Thread thread = new Thread(runnable, "health-check-worker");
+      thread.setDaemon(true);
+      return thread;
+    };
+    this.executor = Executors.newCachedThreadPool(daemonFactory);
+  }
+
+  public void register(HealthCheck check) {
+    checks.add(check);
+  }
+
+  public void start() {
+    Thread loop = new Thread(this, "health-checker");
+    loop.setDaemon(true);
+    loop.start();
+  }
+
+  @Override
+  public void run() {
+    while (!Thread.currentThread().isInterrupted()) {
+      try {
+        long cycleStart = System.currentTimeMillis();
+        runCycle();
+        long remaining = config.healthCheckInterval() * 1000L
+            - (System.currentTimeMillis() - cycleStart);
+        if (remaining > 0) {
+          TimeUnit.MILLISECONDS.sleep(remaining);
+        }
+      } catch (InterruptedException e) {
+        Thread.currentThread().interrupt();
+        return;
+      } catch (Exception e) {
+        log.error("health check cycle failed unexpectedly", e);
+      }
+    }
+  }
+
+  private void runCycle() {
+    Map<String, HealthSnapshot.CheckResult> previous = state.snapshot().results();
+    Map<String, HealthSnapshot.CheckResult> results = new LinkedHashMap<>();
+    results.put("spring-context", state.contextReady()
+        ? new HealthSnapshot.CheckResult(true, "application context ready")
+        : new HealthSnapshot.CheckResult(false, "application context not ready yet"));
+
+    List<HealthCheck> current = List.copyOf(checks);
+    Map<String, Future<?>> futures = new LinkedHashMap<>();
+    for (HealthCheck check : current) {
+      futures.put(check.name(), executor.submit(() -> {
+        check.run();
+        return null;
+      }));
+    }
+    for (Map.Entry<String, Future<?>> entry : futures.entrySet()) {
+      HealthSnapshot.CheckResult result;
+      try {
+        entry.getValue().get(config.healthCheckTimeout(), TimeUnit.SECONDS);
+        result = new HealthSnapshot.CheckResult(true, "ok");
+      } catch (TimeoutException e) {
+        entry.getValue().cancel(true);
+        result = new HealthSnapshot.CheckResult(false,
+            "timed out after " + config.healthCheckTimeout() + "s");
+      } catch (Exception e) {
+        Throwable cause = e.getCause() != null ? e.getCause() : e;
+        result = new HealthSnapshot.CheckResult(false, String.valueOf(cause.getMessage()));
+      }
+      results.put(entry.getKey(), result);
+    }
+
+    HealthSnapshot next = new HealthSnapshot(Map.copyOf(results), System.currentTimeMillis());
+    state.swapSnapshot(next);
+
+    if (!state.started() && next.allOk()) {
+      state.latchStarted();
+      log.info("startup complete: first fully successful health cycle");
+    }
+    logTransitions(previous, results);
+  }
+
+  private void logTransitions(Map<String, HealthSnapshot.CheckResult> previous,
+      Map<String, HealthSnapshot.CheckResult> current) {
+    for (Map.Entry<String, HealthSnapshot.CheckResult> entry : current.entrySet()) {
+      HealthSnapshot.CheckResult before = previous.get(entry.getKey());
+      if (before != null && before.ok() != entry.getValue().ok()) {
+        log.info("health check '{}' transitioned {} -> {} ({})", entry.getKey(),
+            before.ok() ? "ok" : "failing", entry.getValue().ok() ? "ok" : "failing",
+            entry.getValue().detail());
+      }
+    }
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/HealthSnapshot.java b/src/main/java/com/example/jwt/ops/HealthSnapshot.java
new file mode 100644
index 0000000..1e0f402
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/HealthSnapshot.java
@@ -0,0 +1,13 @@
+package com.example.jwt.ops;
+
+import java.util.Map;
+
+/** Immutable result of one full check cycle; swapped behind a single atomic reference. */
+public record HealthSnapshot(Map<String, CheckResult> results, long takenAtMillis) {
+
+  public record CheckResult(boolean ok, String detail) {}
+
+  public boolean allOk() {
+    return results.values().stream().allMatch(CheckResult::ok);
+  }
+}
