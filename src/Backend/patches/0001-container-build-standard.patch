--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/SignalShutdown.java
@@ -0,0 +1,66 @@
+package com.example.jwt.ops;
+
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.context.ConfigurableApplicationContext;
+import sun.misc.Signal;
+
+/**
+ * SIGTERM and SIGINT are handled identically: latch draining, keep serving for
+ * SHUTDOWN_DRAIN_DELAY, then close the context (graceful shutdown bounded by
+ * SHUTDOWN_TIMEOUT via spring.lifecycle.timeout-per-shutdown-phase), exit 0,
+ * or exit 1 when the drain budget was exhausted.
+ */
+public final class SignalShutdown {
+
+  private static final Logger log = LoggerFactory.getLogger(SignalShutdown.class);
+  private static final AtomicBoolean initiated = new AtomicBoolean(false);
+
+  private SignalShutdown() {}
+
+  public static void install(OpsConfig config, HealthState state,
+      ConfigurableApplicationContext context) {
+    Signal.handle(new Signal("TERM"), signal -> initiate(config, state, context));
+    Signal.handle(new Signal("INT"), signal -> initiate(config, state, context));
+  }
+
+  private static void initiate(OpsConfig config, HealthState state,
+      ConfigurableApplicationContext context) {
+    if (!initiated.compareAndSet(false, true)) {
+      return;
+    }
+    Thread drainThread = new Thread(() -> drain(config, state, context), "shutdown-drain");
+    drainThread.start();
+  }
+
+  private static void drain(OpsConfig config, HealthState state,
+      ConfigurableApplicationContext context) {
+    log.info("shutdown signal received: draining (readiness now 503, drain delay {}s)",
+        config.shutdownDrainDelay());
+    state.latchDraining();
+    try {
+      TimeUnit.SECONDS.sleep(config.shutdownDrainDelay());
+    } catch (InterruptedException e) {
+      Thread.currentThread().interrupt();
+    }
+    long begin = System.currentTimeMillis();
+    int exitCode = 0;
+    try {
+      context.close();
+    } catch (Exception e) {
+      log.error("error while closing application context", e);
+      exitCode = 1;
+    }
+    long elapsedMillis = System.currentTimeMillis() - begin;
+    if (elapsedMillis >= config.shutdownTimeout() * 1000L) {
+      log.warn("drain budget of {}s exhausted after {}ms; in-flight work may have been abandoned",
+          config.shutdownTimeout(), elapsedMillis);
+      exitCode = 1;
+    } else {
+      log.info("graceful shutdown complete in {}ms", elapsedMillis);
+    }
+    System.exit(exitCode);
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/TomcatConnectorMetrics.java b/src/main/java/com/example/jwt/ops/TomcatConnectorMetrics.java
new file mode 100644
index 0000000..934d221
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/TomcatConnectorMetrics.java
@@ -0,0 +1,60 @@
+package com.example.jwt.ops;
+
+import io.micrometer.core.instrument.Gauge;
+import io.micrometer.core.instrument.MeterRegistry;
+import java.util.concurrent.Executor;
+import java.util.function.ToDoubleFunction;
+import org.apache.catalina.connector.Connector;
+import org.apache.catalina.startup.Tomcat;
+import org.apache.coyote.AbstractProtocol;
+import org.apache.coyote.ProtocolHandler;
+import org.apache.tomcat.util.threads.ThreadPoolExecutor;
+
+/**
+ * Listener traffic read straight from the Tomcat connector (no JMX, so it
+ * works in the native image): the shared {@code http_server_connections_active}
+ * family every image serves, plus the connector families under Micrometer's
+ * Tomcat names and tags for the case that Micrometer's own MBean-based Tomcat
+ * binder could not register them (a family Micrometer already registered is
+ * left alone).
+ */
+public final class TomcatConnectorMetrics {
+
+  private TomcatConnectorMetrics() {}
+
+  public static void bind(MeterRegistry registry, Tomcat tomcat) {
+    for (Connector connector : tomcat.getService().findConnectors()) {
+      ProtocolHandler handler = connector.getProtocolHandler();
+      if (!(handler instanceof AbstractProtocol<?> protocol)) {
+        continue;
+      }
+      String name = protocol.getName().replace("\"", "");
+      Gauge.builder("http.server.connections.active", protocol, p -> p.getConnectionCount())
+          .description("Open connections on the listener, idle keep-alive connections included.")
+          .tag("listener", "main")
+          .register(registry);
+      gauge(registry, "tomcat.connections.current", "Current connections of the connector.",
+          "connections", name, protocol, p -> p.getConnectionCount());
+      gauge(registry, "tomcat.connections.config.max", "Configured maximum connections of the connector.",
+          "connections", name, protocol, p -> p.getMaxConnections());
+      Executor executor = protocol.getExecutor();
+      if (executor instanceof ThreadPoolExecutor pool) {
+        gauge(registry, "tomcat.threads.busy", "Request threads currently busy.",
+            "threads", name, pool, ThreadPoolExecutor::getActiveCount);
+        gauge(registry, "tomcat.threads.current", "Request threads currently alive.",
+            "threads", name, pool, ThreadPoolExecutor::getPoolSize);
+        gauge(registry, "tomcat.threads.config.max", "Configured maximum request threads.",
+            "threads", name, pool, ThreadPoolExecutor::getMaximumPoolSize);
+      }
+    }
+  }
+
+  private static <T> void gauge(MeterRegistry registry, String meter, String description,
+      String unit, String name, T subject, ToDoubleFunction<T> read) {
+    if (registry.find(meter).tag("name", name).gauge() != null) {
+      return;
+    }
+    Gauge.builder(meter, subject, read).description(description).baseUnit(unit).tag("name", name)
+        .register(registry);
+  }
+}
