+package com.example.jwt.ops;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.Set;
+
+/**
+ * Exec-style probe: `user-mgmt-service healthcheck --endpoint=livez` performs a
+ * local HTTP GET against ADMIN_PORT and exits 0/1, keeping the shell-less image
+ * probeable without curl or wget.
+ */
+public final class ProbeCommand {
+
+  private static final Set<String> ENDPOINTS = Set.of("startupz", "livez", "readyz");
+
+  private ProbeCommand() {}
+
+  public static int run(String[] args) {
+    String endpoint = "livez";
+    for (String arg : args) {
+      if (arg.startsWith("--endpoint=")) {
+        endpoint = arg.substring("--endpoint=".length());
+      }
+    }
+    if (!ENDPOINTS.contains(endpoint)) {
+      System.err.println("unknown endpoint '" + endpoint + "'; allowed: " + ENDPOINTS);
+      return 1;
+    }
+    String adminPort = System.getenv().getOrDefault("ADMIN_PORT", "9090");
+    String host = probeHost(System.getenv().getOrDefault("BIND_ADDR", "0.0.0.0"));
+    try (HttpClient client = HttpClient.newBuilder()
+        .connectTimeout(Duration.ofSeconds(2)).build()) {
+      HttpRequest request = HttpRequest.newBuilder()
+          .uri(URI.create("http://" + host + ":" + adminPort + "/" + endpoint))
+          .timeout(Duration.ofSeconds(3)).GET().build();
+      HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
+      return response.statusCode() == 200 ? 0 : 1;
+    } catch (Exception e) {
+      System.err.println("probe failed: " + e.getMessage());
+      return 1;
+    }
+  }
+
+  private static String probeHost(String bindAddr) {
+    String addr = bindAddr.isBlank() ? "0.0.0.0" : bindAddr.trim();
+    if (addr.equals("0.0.0.0") || addr.equals("*")) {
+      return "127.0.0.1";
+    }
+    if (addr.equals("::")) {
+      return "[::1]";
+    }
+    return addr.contains(":") ? "[" + addr + "]" : addr;
+  }
+}
