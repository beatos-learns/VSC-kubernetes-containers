@@ -0,0 +1,54 @@
+package com.example.jwt.ops;
+
+import io.micrometer.prometheusmetrics.PrometheusMeterRegistry;
+import java.io.IOException;
+
+/**
+ * Process-wide holder wiring the ops machinery started in main() (before the
+ * Spring context exists) to the Spring-managed pieces registered once the
+ * context is ready.
+ */
+public final class Ops {
+
+  private static volatile OpsConfig config;
+  private static volatile HealthState state;
+  private static volatile HealthChecker checker;
+  private static volatile AdminServer admin;
+  private static volatile PrometheusMeterRegistry meterRegistry;
+
+  private Ops() {}
+
+  public static void bootstrap(OpsConfig cfg) throws IOException {
+    config = cfg;
+    state = new HealthState();
+    checker = new HealthChecker(cfg, state);
+    admin = new AdminServer(cfg, state);
+    admin.start();
+    checker.start();
+  }
+
+  public static OpsConfig config() {
+    return config;
+  }
+
+  public static HealthState state() {
+    return state;
+  }
+
+  public static void registerCheck(HealthCheck check) {
+    checker.register(check);
+  }
+
+  /**
+   * Hands the application's Prometheus registry to the admin listener: from
+   * now on /metrics serves the Micrometer families in front of the ops ones.
+   */
+  public static void registerMeterRegistry(PrometheusMeterRegistry registry) {
+    meterRegistry = registry;
+  }
+
+  /** The application registry, or null while the context is still starting. */
+  public static PrometheusMeterRegistry meterRegistry() {
+    return meterRegistry;
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/OpsBootstrap.java b/src/main/java/com/example/jwt/ops/OpsBootstrap.java
new file mode 100644
index 0000000..e48ffd6
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/OpsBootstrap.java
@@ -0,0 +1,121 @@
+package com.example.jwt.ops;
+
+import com.example.jwt.core.security.helpers.Credentials;
+import io.micrometer.core.instrument.Meter;
+import io.micrometer.core.instrument.MeterRegistry;
+import io.micrometer.core.instrument.config.MeterFilter;
+import io.micrometer.core.instrument.config.MeterFilterReply;
+import io.micrometer.prometheusmetrics.PrometheusMeterRegistry;
+import java.sql.Connection;
+import java.sql.Statement;
+import javax.sql.DataSource;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.aot.hint.annotation.RegisterReflectionForBinding;
+import org.springframework.boot.context.event.ApplicationReadyEvent;
+import org.springframework.boot.tomcat.TomcatWebServer;
+import org.springframework.boot.web.server.context.WebServerApplicationContext;
+import org.springframework.boot.web.servlet.FilterRegistrationBean;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.ImportRuntimeHints;
+import org.springframework.context.event.EventListener;
+import org.springframework.core.Ordered;
+
+/**
+ * Wires the Spring-managed pieces into the ops layer started in main(): the
+ * service-function-derived checks, the Prometheus registry behind /metrics,
+ * the listener traffic gauges, and the request filter of the main listener.
+ * The reflection hint covers the hand-instantiated ObjectMapper
+ * deserialization of Credentials in CustomAuthenticationFilter, which Spring
+ * AOT cannot discover.
+ */
+@Configuration(proxyBeanMethods = false)
+@ImportRuntimeHints(OpsRuntimeHints.class)
+@RegisterReflectionForBinding(Credentials.class)
+public class OpsBootstrap {
+
+  private static final Logger log = LoggerFactory.getLogger(OpsBootstrap.class);
+
+  private final DataSource dataSource;
+
+  public OpsBootstrap(DataSource dataSource, PrometheusMeterRegistry registry) {
+    this.dataSource = dataSource;
+    Ops.registerMeterRegistry(registry);
+  }
+
+  /**
+   * Meter-level corrections: a name promtool rejects, and a timer whose route
+   * label cannot be right. Static: the registry applies filters while it is
+   * being created, before this configuration instance (which needs the
+   * registry) exists.
+   */
+  @Bean
+  public static MeterFilter contractNamesMeterFilter() {
+    return new MeterFilter() {
+      @Override
+      public Meter.Id map(Meter.Id id) {
+        return "system.cpu.count".equals(id.getName()) ? id.withName("system.cpus") : id;
+      }
+
+      /**
+       * Micrometer's long task timer for http.server.requests is tagged when the
+       * observation starts, before any route is known, so its uri is always
+       * UNKNOWN; the image serves the plain http_server_requests_active gauge
+       * instead (RequestMetricsFilter), the same family as the other images.
+       */
+      @Override
+      public MeterFilterReply accept(Meter.Id id) {
+        return "http.server.requests.active".equals(id.getName()) && id.getType() == Meter.Type.LONG_TASK_TIMER
+            ? MeterFilterReply.DENY : MeterFilterReply.NEUTRAL;
+      }
+    };
+  }
+
+  @Bean
+  public FilterRegistrationBean<RequestMetricsFilter> requestMetricsFilter(MeterRegistry registry) {
+    OpsConfig config = Ops.config();
+    boolean accessLog = config != null && config.accessLog();
+    FilterRegistrationBean<RequestMetricsFilter> registration =
+        new FilterRegistrationBean<>(new RequestMetricsFilter(registry, accessLog));
+    // inside ServerHttpObservationFilter (HIGHEST_PRECEDENCE + 1), so the route
+    // template can be recorded on the request observation; still ahead of the
+    // security chain
+    registration.setOrder(Ordered.HIGHEST_PRECEDENCE + 2);
+    registration.addUrlPatterns("/*");
+    registration.setName("requestMetricsFilter");
+    return registration;
+  }
+
+  @EventListener(ApplicationReadyEvent.class)
+  public void onApplicationReady(ApplicationReadyEvent event) {
+    OpsConfig config = Ops.config();
+    // After Micrometer's own Tomcat binder (ApplicationStartedEvent), so the
+    // connector gauges only fill in what JMX could not provide.
+    if (event.getApplicationContext() instanceof WebServerApplicationContext web
+        && web.getWebServer() instanceof TomcatWebServer tomcat) {
+      TomcatConnectorMetrics.bind(event.getApplicationContext().getBean(MeterRegistry.class),
+          tomcat.getTomcat());
+    }
+    Ops.registerCheck(new HealthCheck() {
+      @Override
+      public String name() {
+        return "database";
+      }
+
+      @Override
+      public void run() throws Exception {
+        try (Connection connection = dataSource.getConnection();
+            Statement statement = connection.createStatement()) {
+          statement.setQueryTimeout(config.healthCheckTimeout());
+          statement.execute("SELECT 1");
+        }
+      }
+    });
+    Ops.state().markContextReady();
+    log.info("user-mgmt-service started: version={} revision={} config[{}]",
+        System.getenv().getOrDefault("APP_VERSION", "dev"),
+        System.getenv().getOrDefault("APP_REVISION", "unknown"),
+        config.redactedSummary());
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/OpsConfig.java b/src/main/java/com/example/jwt/ops/OpsConfig.java
new file mode 100644
index 0000000..ab148ce
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/OpsConfig.java
@@ -0,0 +1,108 @@
+package com.example.jwt.ops;
+
+import java.util.List;
+
+/**
+ * Runtime configuration surface of the container image contract. Parsed and
+ * validated once at process start; any violation aborts startup immediately.
+ */
+public record OpsConfig(
+    int port,
+    int adminPort,
+    String bindAddr,
+    String logLevel,
+    String logFormat,
+    boolean accessLog,
+    int healthCheckInterval,
+    int healthCheckTimeout,
+    double healthStaleFactor,
+    int shutdownDrainDelay,
+    int shutdownTimeout) {
+
+  public static OpsConfig fromEnvironment() {
+    int port = intEnv("PORT", 8080, 1, 65535);
+    int adminPort = intEnv("ADMIN_PORT", 9090, 1, 65535);
+    String bindAddr = env("BIND_ADDR", "0.0.0.0");
+    String logLevel = enumEnv("LOG_LEVEL", "info", List.of("trace", "debug", "info", "warn", "error"));
+    String logFormat = enumEnv("LOG_FORMAT", "json", List.of("json", "text"));
+    boolean accessLog = boolEnv("ACCESS_LOG", false);
+    int interval = intEnv("HEALTH_CHECK_INTERVAL", 5, 1, 3600);
+    int timeout = intEnv("HEALTH_CHECK_TIMEOUT", 2, 1, 3600);
+    double staleFactor = doubleEnv("HEALTH_STALE_FACTOR", 3.0, 1.0, 100.0);
+    int drainDelay = intEnv("SHUTDOWN_DRAIN_DELAY", 3, 0, 600);
+    int shutdownTimeout = intEnv("SHUTDOWN_TIMEOUT", 10, 1, 3600);
+    if (timeout >= interval) {
+      throw new IllegalStateException(
+          "HEALTH_CHECK_TIMEOUT (" + timeout + "s) must be smaller than HEALTH_CHECK_INTERVAL (" + interval + "s)");
+    }
+    if (port == adminPort) {
+      throw new IllegalStateException("PORT and ADMIN_PORT must differ (both " + port + ")");
+    }
+    return new OpsConfig(port, adminPort, bindAddr, logLevel, logFormat, accessLog,
+        interval, timeout, staleFactor, drainDelay, shutdownTimeout);
+  }
+
+  public String redactedSummary() {
+    return "PORT=" + port
+        + " ADMIN_PORT=" + adminPort
+        + " BIND_ADDR=" + bindAddr
+        + " LOG_LEVEL=" + logLevel
+        + " LOG_FORMAT=" + logFormat
+        + " ACCESS_LOG=" + accessLog
+        + " HEALTH_CHECK_INTERVAL=" + healthCheckInterval
+        + " HEALTH_CHECK_TIMEOUT=" + healthCheckTimeout
+        + " HEALTH_STALE_FACTOR=" + healthStaleFactor
+        + " SHUTDOWN_DRAIN_DELAY=" + shutdownDrainDelay
+        + " SHUTDOWN_TIMEOUT=" + shutdownTimeout;
+  }
+
+  private static String env(String name, String fallback) {
+    String value = System.getenv(name);
+    return (value == null || value.isBlank()) ? fallback : value.trim();
+  }
+
+  private static String enumEnv(String name, String fallback, List<String> allowed) {
+    String value = env(name, fallback).toLowerCase();
+    if (!allowed.contains(value)) {
+      throw new IllegalStateException(name + "=" + value + " is invalid; allowed: " + allowed);
+    }
+    return value;
+  }
+
+  private static boolean boolEnv(String name, boolean fallback) {
+    String value = env(name, Boolean.toString(fallback)).toLowerCase();
+    return switch (value) {
+      case "true", "1", "yes" -> true;
+      case "false", "0", "no" -> false;
+      default -> throw new IllegalStateException(name + "=" + value + " is not a boolean");
+    };
+  }
+
+  private static int intEnv(String name, int fallback, int min, int max) {
+    String raw = env(name, Integer.toString(fallback));
+    int value;
+    try {
+      value = Integer.parseInt(raw);
+    } catch (NumberFormatException e) {
+      throw new IllegalStateException(name + "=" + raw + " is not an integer");
+    }
+    if (value < min || value > max) {
+      throw new IllegalStateException(name + "=" + value + " is outside [" + min + ", " + max + "]");
+    }
+    return value;
+  }
+
+  private static double doubleEnv(String name, double fallback, double min, double max) {
+    String raw = env(name, Double.toString(fallback));
+    double value;
+    try {
+      value = Double.parseDouble(raw);
+    } catch (NumberFormatException e) {
+      throw new IllegalStateException(name + "=" + raw + " is not a number");
+    }
+    if (value < min || value > max) {
+      throw new IllegalStateException(name + "=" + value + " is outside [" + min + ", " + max + "]");
+    }
+    return value;
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/OpsRuntimeHints.java b/src/main/java/com/example/jwt/ops/OpsRuntimeHints.java
new file mode 100644
index 0000000..5efbeb5
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/OpsRuntimeHints.java
@@ -0,0 +1,34 @@
+package com.example.jwt.ops;
+
+import org.springframework.aot.hint.MemberCategory;
+import org.springframework.aot.hint.RuntimeHints;
+import org.springframework.aot.hint.RuntimeHintsRegistrar;
+
+/** Types resolved reflectively at runtime need explicit native-image hints. */
+public class OpsRuntimeHints implements RuntimeHintsRegistrar {
+
+  @Override
+  public void registerHints(RuntimeHints hints, ClassLoader classLoader) {
+    hints.resources().registerResourceBundle("messages");
+    hints.resources().registerResourceBundle("validationMessages");
+    hints.reflection().registerType(java.util.UUID[].class);
+    // The structured log formatter is loaded by name from the logging system.
+    hints.reflection().registerType(EcsFlatFormatter.class, MemberCategory.INVOKE_DECLARED_CONSTRUCTORS);
+    // Tomcat configures its connector through IntrospectionUtils (reflective
+    // setters on the protocol handler and its endpoint); the reachability
+    // metadata registers those only under conditions the image does not meet.
+    hints.reflection().registerType(org.apache.coyote.AbstractProtocol.class, MemberCategory.INVOKE_PUBLIC_METHODS);
+    hints.reflection().registerType(org.apache.coyote.http11.AbstractHttp11Protocol.class, MemberCategory.INVOKE_PUBLIC_METHODS);
+    hints.reflection().registerType(org.apache.coyote.http11.Http11NioProtocol.class, MemberCategory.INVOKE_PUBLIC_METHODS);
+    hints.reflection().registerType(org.apache.tomcat.util.net.AbstractEndpoint.class, MemberCategory.INVOKE_PUBLIC_METHODS);
+    hints.reflection().registerType(org.apache.tomcat.util.net.NioEndpoint.class, MemberCategory.INVOKE_PUBLIC_METHODS);
+    // JWT claim serialization of granted authorities and SpEL in @PreAuthorize
+    // (authentication.principal.user, @userPermissionEvaluator) use reflection.
+    hints.reflection().registerType(org.springframework.security.core.authority.SimpleGrantedAuthority.class,
+        MemberCategory.INVOKE_PUBLIC_CONSTRUCTORS, MemberCategory.INVOKE_PUBLIC_METHODS);
+    hints.reflection().registerType(com.example.jwt.domain.user.UserDetailsImpl.class,
+        MemberCategory.INVOKE_PUBLIC_METHODS);
+    hints.reflection().registerType(com.example.jwt.core.security.permissionevaluators.UserPermissionEvaluator.class,
+        MemberCategory.INVOKE_PUBLIC_METHODS);
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/ProbeCommand.java b/src/main/java/com/example/jwt/ops/ProbeCommand.java
new file mode 100644
index 0000000..18f70ca
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/ProbeCommand.java
@@ -0,0 +1,57 @@
+package com.example.jwt.ops;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.time.Duration;
+import java.util.Set;
+
+/**
+ * Exec-style probe: `user-mgmt-service healthcheck --endpoint=livez` performs a
+ * local HTTP GET against ADMIN_PORT and exits 0/1, keeping the shell-less image
+ * probeable without curl or wget.
+ */
+public final class ProbeCommand {
+
+  private static final Set<String> ENDPOINTS = Set.of("startupz", "livez", "readyz");
+
+  private ProbeCommand() {}
+
+  public static int run(String[] args) {
+    String endpoint = "livez";
+    for (String arg : args) {
+      if (arg.startsWith("--endpoint=")) {
+        endpoint = arg.substring("--endpoint=".length());
+      }
+    }
+    if (!ENDPOINTS.contains(endpoint)) {
+      System.err.println("unknown endpoint '" + endpoint + "'; allowed: " + ENDPOINTS);
+      return 1;
+    }
+    String adminPort = System.getenv().getOrDefault("ADMIN_PORT", "9090");
+    String host = probeHost(System.getenv().getOrDefault("BIND_ADDR", "0.0.0.0"));
+    try (HttpClient client = HttpClient.newBuilder()
+        .connectTimeout(Duration.ofSeconds(2)).build()) {
+      HttpRequest request = HttpRequest.newBuilder()
+          .uri(URI.create("http://" + host + ":" + adminPort + "/" + endpoint))
+          .timeout(Duration.ofSeconds(3)).GET().build();
+      HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
+      return response.statusCode() == 200 ? 0 : 1;
+    } catch (Exception e) {
+      System.err.println("probe failed: " + e.getMessage());
+      return 1;
+    }
+  }
+
+  private static String probeHost(String bindAddr) {
+    String addr = bindAddr.isBlank() ? "0.0.0.0" : bindAddr.trim();
+    if (addr.equals("0.0.0.0") || addr.equals("*")) {
+      return "127.0.0.1";
+    }
+    if (addr.equals("::")) {
+      return "[::1]";
+    }
+    return addr.contains(":") ? "[" + addr + "]" : addr;
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/RequestMetricsFilter.java b/src/main/java/com/example/jwt/ops/RequestMetricsFilter.java
new file mode 100644
index 0000000..d690e80
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/RequestMetricsFilter.java
@@ -0,0 +1,274 @@
+package com.example.jwt.ops;
+
+import io.micrometer.core.instrument.Counter;
+import io.micrometer.core.instrument.Gauge;
+import io.micrometer.core.instrument.MeterRegistry;
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ReadListener;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.ServletInputStream;
+import jakarta.servlet.ServletOutputStream;
+import jakarta.servlet.WriteListener;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletRequestWrapper;
+import jakarta.servlet.http.HttpServletResponse;
+import jakarta.servlet.http.HttpServletResponseWrapper;
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.util.Set;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.regex.Pattern;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.slf4j.MDC;
+import org.springframework.web.filter.OncePerRequestFilter;
+
+/**
+ * Request filter of the main listener, directly inside Spring's request
+ * observation filter: request-id correlation
+ * (X-Request-Id in, echoed out, MDC http.request.id), per-route request and
+ * response byte counters, the route template for requests the security chain
+ * answers itself, and the optional access log line. Never touches the admin
+ * listener, never logs headers, bodies, query strings or client addresses.
+ */
+public final class RequestMetricsFilter extends OncePerRequestFilter {
+
+  public static final String REQUEST_ID_HEADER = "X-Request-Id";
+  public static final String MDC_REQUEST_ID = "http.request.id";
+
+  private static final Pattern REQUEST_ID = Pattern.compile("[A-Za-z0-9._-]{1,128}");
+  private static final Logger access = LoggerFactory.getLogger("access");
+
+  private static final Set<String> METHODS = Set.of("GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS");
+
+  private final MeterRegistry registry;
+  private final boolean accessLog;
+  private final ConcurrentHashMap<String, AtomicInteger> inFlight = new ConcurrentHashMap<>();
+
+  public RequestMetricsFilter(MeterRegistry registry, boolean accessLog) {
+    this.registry = registry;
+    this.accessLog = accessLog;
+  }
+
+  @Override
+  protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response,
+      FilterChain chain) throws ServletException, IOException {
+    String requestId = requestId(request);
+    MDC.put(MDC_REQUEST_ID, requestId);
+    response.setHeader(REQUEST_ID_HEADER, requestId);
+    String known = RouteTemplates.match(request.getMethod(), RouteTemplates.path(request));
+    if (known != null) {
+      RouteTemplates.announce(request, known);
+    }
+    AtomicInteger active = inFlight(request.getMethod(), known == null ? RouteTemplates.UNKNOWN : known);
+    active.incrementAndGet();
+    CountingRequest countingRequest = new CountingRequest(request);
+    CountingResponse countingResponse = new CountingResponse(response);
+    long begin = System.nanoTime();
+    try {
+      chain.doFilter(countingRequest, countingResponse);
+    } finally {
+      active.decrementAndGet();
+      long durationNanos = System.nanoTime() - begin;
+      int status = response.getStatus();
+      String uri = RouteTemplates.label(request, status);
+      long requestBytes = Math.max(countingRequest.bytesRead(), Math.max(0L, request.getContentLengthLong()));
+      long responseBytes = countingResponse.bytesWritten();
+      counter("http.server.request.bytes", "Request body bytes received per route.", uri).increment(requestBytes);
+      counter("http.server.response.bytes", "Response body bytes sent per route.", uri).increment(responseBytes);
+      if (accessLog) {
+        access.atInfo()
+            .addKeyValue("http.request.method", request.getMethod())
+            .addKeyValue("url.path", uri)
+            .addKeyValue("http.response.status_code", status)
+            .addKeyValue("event.duration", durationNanos)
+            .addKeyValue("http.request.bytes", requestBytes)
+            .addKeyValue("http.response.bytes", responseBytes)
+            .log("{} {} {}", request.getMethod(), uri, status);
+      }
+      MDC.remove(MDC_REQUEST_ID);
+    }
+  }
+
+  /** One gauge per (method, route) known at entry: bounded by the route table. */
+  private AtomicInteger inFlight(String method, String uri) {
+    String normalizedMethod = METHODS.contains(method) ? method : "OTHER";
+    return inFlight.computeIfAbsent(normalizedMethod + " " + uri, key -> {
+      AtomicInteger counter = new AtomicInteger();
+      Gauge.builder("http.server.requests.active", counter, AtomicInteger::get)
+          .description("Requests in flight per route (the route known when the request arrived).")
+          .tag("method", normalizedMethod).tag("uri", uri)
+          .register(registry);
+      return counter;
+    });
+  }
+
+  private Counter counter(String name, String description, String uri) {
+    return Counter.builder(name).description(description).baseUnit("bytes").tag("uri", uri)
+        .register(registry);
+  }
+
+  private static String requestId(HttpServletRequest request) {
+    String incoming = request.getHeader(REQUEST_ID_HEADER);
+    if (incoming != null && REQUEST_ID.matcher(incoming).matches()) {
+      return incoming;
+    }
+    return UUID.randomUUID().toString();
+  }
+
+  /** Counts the body bytes the application actually reads. */
+  private static final class CountingRequest extends HttpServletRequestWrapper {
+
+    private long bytes;
+    private ServletInputStream stream;
+
+    CountingRequest(HttpServletRequest request) {
+      super(request);
+    }
+
+    long bytesRead() {
+      return bytes;
+    }
+
+    @Override
+    public ServletInputStream getInputStream() throws IOException {
+      if (stream == null) {
+        ServletInputStream delegate = super.getInputStream();
+        stream = new ServletInputStream() {
+          @Override
+          public int read() throws IOException {
+            int value = delegate.read();
+            if (value >= 0) {
+              bytes++;
+            }
+            return value;
+          }
+
+          @Override
+          public int read(byte[] buffer, int offset, int length) throws IOException {
+            int count = delegate.read(buffer, offset, length);
+            if (count > 0) {
+              bytes += count;
+            }
+            return count;
+          }
+
+          @Override
+          public int available() throws IOException {
+            return delegate.available();
+          }
+
+          @Override
+          public void close() throws IOException {
+            delegate.close();
+          }
+
+          @Override
+          public boolean isFinished() {
+            return delegate.isFinished();
+          }
+
+          @Override
+          public boolean isReady() {
+            return delegate.isReady();
+          }
+
+          @Override
+          public void setReadListener(ReadListener listener) {
+            delegate.setReadListener(listener);
+          }
+        };
+      }
+      return stream;
+    }
+  }
+
+  /**
+   * Counts the body bytes the application writes (text written through the
+   * Writer API is counted in characters).
+   */
+  private static final class CountingResponse extends HttpServletResponseWrapper {
+
+    private long bytes;
+    private ServletOutputStream stream;
+    private PrintWriter writer;
+
+    CountingResponse(HttpServletResponse response) {
+      super(response);
+    }
+
+    long bytesWritten() {
+      return bytes;
+    }
+
+    @Override
+    public ServletOutputStream getOutputStream() throws IOException {
+      if (stream == null) {
+        ServletOutputStream delegate = super.getOutputStream();
+        stream = new ServletOutputStream() {
+          @Override
+          public void write(int value) throws IOException {
+            delegate.write(value);
+            bytes++;
+          }
+
+          @Override
+          public void write(byte[] buffer, int offset, int length) throws IOException {
+            delegate.write(buffer, offset, length);
+            bytes += length;
+          }
+
+          @Override
+          public void flush() throws IOException {
+            delegate.flush();
+          }
+
+          @Override
+          public void close() throws IOException {
+            delegate.close();
+          }
+
+          @Override
+          public boolean isReady() {
+            return delegate.isReady();
+          }
+
+          @Override
+          public void setWriteListener(WriteListener listener) {
+            delegate.setWriteListener(listener);
+          }
+        };
+      }
+      return stream;
+    }
+
+    @Override
+    public PrintWriter getWriter() throws IOException {
+      if (writer == null) {
+        PrintWriter delegate = super.getWriter();
+        writer = new PrintWriter(delegate, false) {
+          @Override
+          public void write(int value) {
+            super.write(value);
+            bytes++;
+          }
+
+          @Override
+          public void write(char[] buffer, int offset, int length) {
+            super.write(buffer, offset, length);
+            bytes += length;
+          }
+
+          @Override
+          public void write(String text, int offset, int length) {
+            super.write(text, offset, length);
+            bytes += length;
+          }
+        };
+      }
+      return writer;
+    }
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/RouteTemplates.java b/src/main/java/com/example/jwt/ops/RouteTemplates.java
new file mode 100644
index 0000000..4a907e9
--- /dev/null
+++ b/src/main/java/com/example/jwt/ops/RouteTemplates.java
@@ -0,0 +1,94 @@
+package com.example.jwt.ops;
+
+import jakarta.servlet.http.HttpServletRequest;
+import java.util.Optional;
+import org.springframework.http.server.observation.ServerRequestObservationContext;
+import org.springframework.web.filter.ServerHttpObservationFilter;
+import org.springframework.web.servlet.HandlerMapping;
+import org.springframework.web.util.pattern.PathPattern;
+
+/**
+ * The route templates of the main listener as they appear in the {@code uri}
+ * label. Spring MVC records the matched pattern on the request observation for
+ * controller routes itself; the login route is served by the security filter
+ * chain and requests the security chain rejects never reach a handler, so the
+ * template of every known route is set up front. Anything else follows
+ * Micrometer's own fallbacks: {@code NOT_FOUND}, {@code REDIRECTION},
+ * {@code root}, {@code UNKNOWN}.
+ */
+public final class RouteTemplates {
+
+  public static final String UNKNOWN = "UNKNOWN";
+
+  private RouteTemplates() {}
+
+  /** The template of a known route for this method and path, or null. */
+  public static String match(String method, String path) {
+    switch (path) {
+      case "/users/login":
+        return "POST".equals(method) ? "/users/login" : null;
+      case "/users/register":
+        return "POST".equals(method) ? "/users/register" : null;
+      case "/users/me":
+        return "GET".equals(method) ? "/users/me" : null;
+      case "/users":
+        return "GET".equals(method) ? "/users" : null;
+      default:
+        break;
+    }
+    if (path.startsWith("/users/") && path.length() > 7 && path.indexOf('/', 7) < 0
+        && ("GET".equals(method) || "PUT".equals(method) || "DELETE".equals(method))) {
+      return "/users/{id}";
+    }
+    return null;
+  }
+
+  /** The servlet-relative request path. */
+  public static String path(HttpServletRequest request) {
+    String uri = request.getRequestURI();
+    String context = request.getContextPath();
+    if (context != null && !context.isEmpty() && uri.startsWith(context)) {
+      uri = uri.substring(context.length());
+    }
+    return uri.isEmpty() ? "/" : uri;
+  }
+
+  /** Records the template on the request observation Micrometer reads the uri label from. */
+  public static void announce(HttpServletRequest request, String template) {
+    Optional<ServerRequestObservationContext> context = ServerHttpObservationFilter.findObservationContext(request);
+    context.ifPresent(c -> c.setPathPattern(template));
+    request.setAttribute(RouteTemplates.class.getName(), template);
+  }
+
+  /**
+   * The {@code uri} label value after the request completed, identical to what
+   * Micrometer's server observation convention records: the pattern the
+   * handler mapping (or {@link #announce}) recorded, else a status-derived
+   * fallback.
+   */
+  public static String label(HttpServletRequest request, int status) {
+    String matched = ServerHttpObservationFilter.findObservationContext(request)
+        .map(ServerRequestObservationContext::getPathPattern)
+        .orElse(null);
+    if (matched == null) {
+      Object pattern = request.getAttribute(HandlerMapping.BEST_MATCHING_PATTERN_ATTRIBUTE);
+      if (pattern instanceof PathPattern pathPattern) {
+        matched = pathPattern.getPatternString();
+      } else if (pattern instanceof String string) {
+        matched = string;
+      } else if (request.getAttribute(RouteTemplates.class.getName()) instanceof String announced) {
+        matched = announced;
+      }
+    }
+    if (matched != null) {
+      return matched.isEmpty() ? "root" : matched;
+    }
+    if (status >= 300 && status < 400) {
+      return "REDIRECTION";
+    }
+    if (status == 404) {
+      return "NOT_FOUND";
+    }
+    return UNKNOWN;
+  }
+}
diff --git a/src/main/java/com/example/jwt/ops/SignalShutdown.java b/src/main/java/com/example/jwt/ops/SignalShutdown.java
