@@ -0,0 +1,87 @@
+package com.example.jwt.domain.module;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.sun.net.httpserver.HttpServer;
+import io.github.resilience4j.circuitbreaker.CallNotPermittedException;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.web.client.HttpClientErrorException;
+import org.springframework.web.client.HttpServerErrorException;
+import org.springframework.web.client.RestClient;
+
+class ModuleServiceClientTest {
+
+  private final UUID id = UUID.randomUUID();
+  private final String module =
+      "{\"id\":\"" + id + "\",\"code\":\"CLOUD-ARCH\",\"name\":\"Cloud Architecture\"}";
+  private final Deque<Integer> statuses = new ArrayDeque<>();
+  private final AtomicInteger requests = new AtomicInteger();
+  private HttpServer server;
+  private ModuleServiceClient client;
+
+  @BeforeEach
+  void start() throws IOException {
+    server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+    server.createContext("/", exchange -> {
+      requests.incrementAndGet();
+      int status = statuses.isEmpty() ? 500 : statuses.poll();
+      byte[] body = status == 200 ? module.getBytes(StandardCharsets.UTF_8) : new byte[0];
+      exchange.getResponseHeaders().add("Content-Type", "application/json");
+      exchange.sendResponseHeaders(status, body.length == 0 ? -1 : body.length);
+      try (OutputStream out = exchange.getResponseBody()) {
+        out.write(body);
+      }
+    });
+    server.start();
+    client = new ModuleServiceClient(RestClient.builder(), new ModuleServiceProperties(
+        "http://127.0.0.1:" + server.getAddress().getPort(), 1000, 1000, 3, 1, 60000));
+  }
+
+  @AfterEach
+  void stop() {
+    server.stop(0);
+  }
+
+  @Test
+  void findsModuleById() {
+    statuses.add(200);
+    assertThat(client.findById(id).code()).isEqualTo("CLOUD-ARCH");
+    assertThat(requests.get()).isEqualTo(1);
+  }
+
+  @Test
+  void doesNotRetryClientErrors() {
+    statuses.add(404);
+    assertThatThrownBy(() -> client.findById(id))
+        .isInstanceOf(HttpClientErrorException.NotFound.class);
+    assertThat(requests.get()).isEqualTo(1);
+  }
+
+  @Test
+  void retriesServerErrors() {
+    statuses.addAll(List.of(500, 500, 200));
+    assertThat(client.findById(id).id()).isEqualTo(id);
+    assertThat(requests.get()).isEqualTo(3);
+  }
+
+  @Test
+  void opensCircuitAfterRepeatedFailures() {
+    for (int i = 0; i < 5; i++) {
+      assertThatThrownBy(client::findAll).isInstanceOf(HttpServerErrorException.class);
+    }
+    assertThatThrownBy(client::findAll).isInstanceOf(CallNotPermittedException.class);
+    assertThat(requests.get()).isEqualTo(15);
+  }
+}
