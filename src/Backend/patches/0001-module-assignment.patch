+package com.example.jwt.domain.module;
+
+import jakarta.validation.Valid;
+import java.util.List;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.validation.annotation.Validated;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+@Validated
+@RestController
+@RequestMapping("/modules")
+public class ModuleController {
+
+  private final ModuleServiceClient moduleServiceClient;
+
+  public ModuleController(ModuleServiceClient moduleServiceClient) {
+    this.moduleServiceClient = moduleServiceClient;
+  }
+
+  @GetMapping({"", "/"})
+  public ResponseEntity<List<ModuleDTO>> retrieveAll() {
+    return ResponseEntity.ok(moduleServiceClient.findAll());
+  }
+
+  @PostMapping({"", "/"})
+  @PreAuthorize("hasAuthority('USER_MODIFY')")
+  public ResponseEntity<ModuleDTO> create(@Valid @RequestBody ModuleDTO moduleDTO) {
+    return ResponseEntity.status(HttpStatus.CREATED).body(moduleServiceClient.create(moduleDTO));
+  }
+}
