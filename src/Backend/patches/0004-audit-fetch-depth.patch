+# The audit users of every entity (created_by, last_modified_by) are loaded by
+# their own selects. Joined into the entity query they multiply the eager roles
+# and authorities per user level, and a user that last modified itself makes
+# that product grow with every level.
+spring.jpa.properties.hibernate.max_fetch_depth=0
 
